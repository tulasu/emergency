# GPU-воркер: GigaAM (onnx) + e5-tuned и laya на CUDA + живой Silero.
# Нужен NVIDIA Container Toolkit на хосте (docker run --gpus all ... nvidia-smi).
# CUDA runtime приезжает колёсами torch cu130 — базовый CUDA-образ не нужен,
# драйвер пробрасывает toolkit.
FROM python:3.12-slim
WORKDIR /app
# gcc — Triton (laya) собирает свой модуль при первом запуске
RUN apt-get update && apt-get install -y --no-install-recommends \
    espeak-ng ffmpeg gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu130 \
    "torch==2.14.0"
RUN pip install --no-cache-dir \
    "pymorphy3==2.0.6" "razdel==0.5.0" "numpy>=2.0" "PyYAML>=6.0" "setuptools<81" \
    "onnxruntime==1.30.0" "tokenizers==0.23.2" "transformers==5.17.0" \
    "safetensors==0.8.0" "laya==0.3.4" "omegaconf" "vosk>=0.3.45"
COPY pyproject.toml ./
COPY dispatcher ./dispatcher
COPY tools ./tools
EXPOSE 8000 9001
CMD ["sh", "tools/serve.sh"]
