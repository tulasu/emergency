r&gt;(just call / curl)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="200" height="1400" as="geometry"/></mxCell><mxCell id="c321" value="orchestrator&lt;br&gt;(Go :8080)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="200" height="1400" as="geometry"/></mxCell><mxCell id="c322" value="dispatcher python&lt;br&gt;(:8000 HTTP)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="620" y="90" width="200" height="1400" as="geometry"/></mxCell><mxCell id="c323" value="Asterisk&lt;br&gt;(ARI :8088, SIP 5060)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="910" y="90" width="200" height="1400" as="geometry"/></mxCell><mxCell id="c324" value="Софтфон&lt;br&gt;обучающегося" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1200" y="90" width="200" height="1400" as="geometry"/></mxCell><mxCell id="c325" value="AudioSocket :9001&lt;br&gt;+ Call (media)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1490" y="90" width="200" height="1400" as="geometry"/></mxCell><mxCell id="c326" value="Session / Cascade&lt;br&gt;(ядро)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1780" y="90" width="200" height="1400" as="geometry"/></mxCell><mxCell id="c327" value="llama-server&lt;br&gt;:8081" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="2070" y="90" width="200" height="1400" as="geometry"/></mxCell><mxCell id="c328" value="POST /calls {to:'op_test', scenario_id}" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="170" as="sourcePoint"/><mxPoint x="430" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c329" value="POST /sessions/check {scenario_id} → 200 | 404" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="212" as="sourcePoint"/><mxPoint x="720" y="212" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c330" value="call_id = uuid4 hex; RTP-порт = RTP_BASE + n; ListenUDP" style="text;html=1;fontSize=10;align=left;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="440" y="238" width="260" height="30" as="geometry"/></mxCell><mxCell id="c331" value="POST /sessions/open {scenario_id, session_id=call_id}" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="296" as="sourcePoint"/><mxPoint x="720" y="296" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c332" value="Service.open: load scenario, new Cascade (синглтоны: Ontology, LexicalBank, Encoder, VectorBank, Laya)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="338" as="sourcePoint"/><mxPoint x="1880" y="338" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c333" value="{session_id, opening}" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="380" as="sourcePoint"/><mxPoint x="430" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c334" value="ARI POST /channels endpoint=PJSIP/op_test, context=trainer-in, vars scenario_id, call_id, go_rtp_port" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="422" as="sourcePoint"/><mxPoint x="1010" y="422" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c335" value="202 {call_id, to, scenario_id, rtp_port}" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="464" as="sourcePoint"/><mxPoint x="140" y="464" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c336" value="SIP INVITE (alaw)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="506" as="sourcePoint"/><mxPoint x="1300" y="506" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c337" value="200 OK (ответили)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="548" as="sourcePoint"/><mxPoint x="1010" y="548" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c338" value="Answer() → AudioSocket(uuid, 127.0.0.1:9001): TCP, фреймы kind+len+SLIN 8k" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="590" as="sourcePoint"/><mxPoint x="1590" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c339" value="берёт ПОСЛЕДНЮЮ открытую сессию из SVC.sessions (не по call_id!)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1590" y="632" as="sourcePoint"/><mxPoint x="1880" y="632" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c340" value="opening: предрендер wav (data/audio) или Silero TTS; writer 320 байт / 20 мс" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1590" y="674" as="sourcePoint"/><mxPoint x="1010" y="674" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c341" value="оператор говорит: RTP" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="716" as="sourcePoint"/><mxPoint x="1010" y="716" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c342" value="SLIN кадры" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="758" as="sourcePoint"/><mxPoint x="1590" y="758" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c343" value="VAD (энергия) · half-duplex · STT partial (GigaAM/Vosk/Whisper)" style="text;html=1;fontSize=10;align=left;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1600" y="784" width="260" height="30" as="geometry"/></mxCell><mxCell id="c344" value="on_partial(text) — спекуляция _draft (ответ считается заранее)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1590" y="842" as="sourcePoint"/><mxPoint x="1880" y="842" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c345" value="VAD «договорил» → on_final(text)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1590" y="884" as="sourcePoint"/><mxPoint x="1880" y="884" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c346" value="Ensemble: голос LLM (choose slot, 1 цифра) · Improviser (ответ вне сценария)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1880" y="926" as="sourcePoint"/><mxPoint x="2170" y="926" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c347" value="slot | 0 · короткая фраза (проверка: без чисел/имён)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2170" y="968" as="sourcePoint"/><mxPoint x="1880" y="968" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c348" value="Reply {text, audio_id, style, mood}" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1880" y="1010" as="sourcePoint"/><mxPoint x="1590" y="1010" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c349" value="аудио ответа (wav по audio_id или живой TTS)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1590" y="1052" as="sourcePoint"/><mxPoint x="1010" y="1052" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c350" value="RTP" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="1094" as="sourcePoint"/><mxPoint x="1300" y="1094" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c351" value="оператор перебил (barge-in)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="1136" as="sourcePoint"/><mxPoint x="1010" y="1136" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c352" value="cancel() → stop audio_id" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1590" y="1178" as="sourcePoint"/><mxPoint x="1880" y="1178" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c353" value="лог: data/calls/&amp;lt;ts&amp;gt;_&amp;lt;scenario&amp;gt;/NNN.wav + turns.jsonl" style="text;html=1;fontSize=10;align=left;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1600" y="1204" width="260" height="30" as="geometry"/></mxCell><mxCell id="c354" value="BYE" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="1262" as="sourcePoint"/><mxPoint x="1010" y="1262" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c355" value="hangup-фрейм / закрытие сокета" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="1304" as="sourcePoint"/><mxPoint x="1590" y="1304" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c356" value="close(): cascade.save(), сессия удалена из реестра" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1590" y="1346" as="sourcePoint"/><mxPoint x="1880" y="1346" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c357" value="DELETE /calls/{id} → drop (UDP закрыт), 204; канал не рвёт — ждёт BYE" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="1388" as="sourcePoint"/><mxPoint x="430" y="1388" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c358" value="Эталон без SIP: &lt;code&gt;python -m dispatcher.cli chat|replay &amp;lt;scenario&amp;gt;&lt;/code&gt;. Требование: replay --stream ≡ replay посимвольно (test_stream_matches_text). Расхождение звонка с CLI — баг транспорта." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1500" width="800" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p847" name="7. dispatcher: NLU и диалог"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c359" value="&lt;b style='font-size:22px'&gt;dispatcher — ядро «заявителя»: реплика → слот онтологии → факт сценария → ответ&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;Задача классификационная, не генеративная: текст ответа всегда берётся из сценария. Нет факта для слота → «не знаю» (правильный ответ). Слои общаются только типами из types.py.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="60" as="geometry"/></mxCell><mxCell id="c360" value="&lt;b&gt;Реплика оператора&lt;/b&gt;&lt;br&gt;текст (STT final / CLI)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="180" height="70" as="geometry"/></mxCell><mxCell id="c361" value="&lt;b&gt;normalize.py&lt;/b&gt;&lt;br&gt;razdel + pymorphy3: леммы, числа (слова→int), сегменты&lt;br&gt;content_lemmas / topical_lemmas&lt;br&gt;(вопросительные слова и местоимения НЕ выкидываются)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="100" width="280" height="110" as="geometry"/></mxCell><mxCell id="c362" value="Cascade (per-call, nlu/cascade.py) — Understander" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="900" height="540" as="geometry"/></mxCell><mxCell id="c363" value="&lt;b&gt;1. rules.py&lt;/b&gt; ~0.03 мс&lt;br&gt;детект акта: ask / confirm / assert / speech_act&lt;br&gt;ack, «повторите», уточнение-эллипсис «а корпус?» (family слота)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c362"><mxGeometry x="20" y="30" width="400" height="80" as="geometry"/></mxCell><mxCell id="c364" value="&lt;b&gt;2. LexicalBank&lt;/b&gt; (bank.py) + &lt;b&gt;VectorBank&lt;/b&gt; (vectors.py)&lt;br&gt;банк формулировок всего корпуса по 88–91 слотам (data/build/bank.json)&lt;br&gt;сплав лексики и косинуса энкодера e5-small(-tuned); вычет фона слота&lt;br&gt;оценка по ВСЕМ слотам; уверенность = разрыв до 2-го кандидата с другим ответом&lt;br&gt;0.4 мс без модели, ~9 мс со сплавом" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c362"><mxGeometry x="20" y="120" width="400" height="130" as="geometry"/></mxCell><mxCell id="c365" value="&lt;b&gt;3. Арбитр серой зоны&lt;/b&gt; (опц., --arbiter)&lt;br&gt;LayaArbiter (laya-multilingual, 1 проход, умеет отказ) · thin_rescue — только слоты &amp;lt;40 формулировок&lt;br&gt;LlmArbiter (Qwen, ответ 1 цифрой, 0 = «ни о чём», варианты перемешаны)&lt;br&gt;NullArbiter по умолчанию" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c362"><mxGeometry x="20" y="260" width="400" height="110" as="geometry"/></mxCell><mxCell id="c366" value="&lt;b&gt;Ensemble&lt;/b&gt; (--ensemble, ensemble.py)&lt;br&gt;голоса: каскад + laya + LLM (ThreadPool)&lt;br&gt;правила: majority · strict · cascade+ · llm-lead&lt;br&gt;«ни о чём» — тоже голос" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c362"><mxGeometry x="450" y="30" width="430" height="100" as="geometry"/></mxCell><mxCell id="c367" value="&lt;b&gt;LayaUnderstander&lt;/b&gt; (--nlu laya)&lt;br&gt;альтернатива банку целиком: классификация прямо в слоты сценария, описание варианта = ответ заявителя; ни одной формулировки не нужно" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;dashed=1;" vertex="1" parent="c362"><mxGeometry x="450" y="150" width="430" height="90" as="geometry"/></mxCell><mxCell id="c368" value="&lt;b&gt;Encoder&lt;/b&gt; (encoder.py)&lt;br&gt;TorchEncoder (cuda) | OnnxEncoder (cpu)&lt;br&gt;модели: e5-small, e5-small-tuned(-rerun/-stt), rubert-tiny2, labse-ru-turbo" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c362"><mxGeometry x="450" y="260" width="430" height="80" as="geometry"/></mxCell><mxCell id="c369" value="&lt;b&gt;NluState&lt;/b&gt;: last_slots, last_family, turn (эллипсис)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10;" vertex="1" parent="c362"><mxGeometry x="20" y="390" width="400" height="40" as="geometry"/></mxCell><mxCell id="c370" value="&lt;b&gt;Thresholds&lt;/b&gt;: пресеты под lexical / tuned — смешивать нельзя (калибровка по слепым наборам)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10;" vertex="1" parent="c362"><mxGeometry x="450" y="360" width="430" height="50" as="geometry"/></mxCell><mxCell id="c371" value="&lt;b&gt;Understanding&lt;/b&gt;&lt;br&gt;slots[], keys[] (факты), act, score, words, topical, value_mismatch, source (cache|rules|bank|arbiter), latency_ms&lt;br&gt;&lt;i&gt;slots≠∅ и keys=∅ ⇒ «понял, но не знаю»&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c362"><mxGeometry x="20" y="450" width="860" height="70" as="geometry"/></mxCell><mxCell id="c372" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c362" source="c363" target="c364"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c373" value="серая зона" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c362" source="c364" target="c365"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c374" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="c362" source="c364" target="c368"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c375" value="&lt;b&gt;policy.decide(u, CallState, Scenario)&lt;/b&gt; — чистая функция&lt;br&gt;1. speech_act → ACK, настроение ↓&lt;br&gt;2. keys=∅ → MISHEAR (topical=0) или DONT_KNOW, + инициатива (urge)&lt;br&gt;3. requires не раскрыты → DONT_KNOW&lt;br&gt;4. value_mismatch → CORRECT&lt;br&gt;5. confirm → CONFIRM&lt;br&gt;6. иначе PLAIN / SHORT (повтор), ≤ max_facts_per_turn, SLOW_DOWN при залпе&lt;br&gt;дрейф настроения, critical_wait, initiative_cooldown" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1500" y="90" width="420" height="230" as="geometry"/></mxCell><mxCell id="c376" value="&lt;b&gt;Decision&lt;/b&gt;: reveal[], style, mood, unprompted" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1500" y="340" width="420" height="40" as="geometry"/></mxCell><mxCell id="c377" value="&lt;b&gt;CallState&lt;/b&gt;: turn, revealed, asked{}, idle_turns, mood, last_reveal…" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1960" y="150" width="300" height="60" as="geometry"/></mxCell><mxCell id="c378" value="&lt;b&gt;Renderer&lt;/b&gt; (render.py)&lt;br&gt;текст = Fact.answers[style] | plain; склейка фактов; audio_id из Fact.audio (предрендер) или common/&amp;lt;style&amp;gt;/&amp;lt;mood&amp;gt;_n.wav" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1500" y="400" width="420" height="90" as="geometry"/></mxCell><mxCell id="c379" value="&lt;b&gt;Improviser&lt;/b&gt; (--improv, improv.py)&lt;br&gt;на DONT_KNOW: LLM отвечает от лица заявителя; видит только вводную и уже сказанное; фильтр: без чисел, имён, времени, ≤2 фраз; иначе дежурное «не знаю»" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1960" y="400" width="300" height="120" as="geometry"/></mxCell><mxCell id="c380" value="&lt;b&gt;Reply&lt;/b&gt;&lt;br&gt;text, audio_id, style (plain/short/confirm/correct/dont_know/mishear/slow_down/ack), mood (0..2)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1500" y="520" width="420" height="70" as="geometry"/></mxCell><mxCell id="c381" value="&lt;b&gt;Turn&lt;/b&gt; (журнал Session.turns): n, utterance, understanding, decision, reply" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1500" y="610" width="420" height="40" as="geometry"/></mxCell><mxCell id="c382" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c360" target="c361"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c383" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c361" target="c362"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c384" value="Understanding" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c362" target="c375"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c385" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c375" target="c376"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c386" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c376" target="c378"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c387" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c378" target="c380"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c388" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c377" target="c375"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c389" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c379" target="c378"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c390" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c380" target="c381"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c391" value="Session (session.py) и Service (service.py)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="1440" height="250" as="geometry"/></mxCell><mxCell id="c392" value="&lt;b&gt;Session.open(scenario, cascade, onto)&lt;/b&gt; → opening() (приветствие из persona.opening)&lt;br&gt;&lt;b&gt;on_partial(text)&lt;/b&gt; — хода не порождает; фильтр &amp;lt;6 символов/дубликат; спекулятивно считает ответ (_draft) через understander.preview()&lt;br&gt;&lt;b&gt;on_final(text)&lt;/b&gt; — если текст совпал с _draft, ответ готов сразу; иначе understand → decide → render → Reply; пишет Turn&lt;br&gt;&lt;b&gt;cancel()&lt;/b&gt; — barge-in: снять спекуляцию, вернуть audio_id прерванной реплики&lt;br&gt;&lt;b&gt;close()&lt;/b&gt; — cascade.save(); &lt;b&gt;say(text)&lt;/b&gt; = on_final без partial (текстовый дубль)&lt;br&gt;&lt;br&gt;&lt;b&gt;Service&lt;/b&gt;: реестр session_id → Session, open/partial/final/cancel/close; синглтоны на процесс: Ontology, LexicalBank, Encoder, VectorBank, LayaArbiter (прогрев до ~1–2 мин). Cascade/Session/CallState — per-call.&lt;br&gt;Вызовы одной сессии строго последовательны (serve.py держит глобальный LOCK на все запросы)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="c391"><mxGeometry x="10" y="30" width="1420" height="210" as="geometry"/></mxCell><mxCell id="c393" value="Медиа (dispatcher/media)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1500" y="680" width="760" height="250" as="geometry"/></mxCell><mxCell id="c394" value="&lt;b&gt;asterisk.py · Call&lt;/b&gt;: AudioSocket-протокол (kind 1 байт + len 3 + payload), энергетический VAD, endpoint по тишине, barge-in, half-duplex, upsample 8→16 кГц для STT, load_reply_pcm(audio_id)&lt;br&gt;&lt;b&gt;STT&lt;/b&gt; (Transcriber: partial/final): &lt;b&gt;GigaAM-v2 CTC&lt;/b&gt; onnx (дефолт) · Vosk small-ru (стриминг, CPU) · faster-whisper tiny · StubSTT&lt;br&gt;&lt;b&gt;TTS&lt;/b&gt;: предрендер tools/synth_audio.py (3598 wav, index.json) → иначе &lt;b&gt;SileroTTS&lt;/b&gt; v4_ru (48k → 8k, цифры словами, GPU)&lt;br&gt;Лог звонка: data/calls/&amp;lt;ts&amp;gt;_&amp;lt;scenario&amp;gt;/ NNN.wav + turns.jsonl (датасет для дообучения)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="c393"><mxGeometry x="10" y="30" width="740" height="210" as="geometry"/></mxCell><mxCell id="c395" value="&lt;b&gt;CLI&lt;/b&gt; (python -m dispatcher.cli): chat · replay [-f dialog.txt] [--stream] · slots · lint · suggest «фраза» · флаги --nlu laya, --fresh, -v" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c396" value="&lt;b&gt;bench/&lt;/b&gt;: loo (сценарий vs банк без него) · run (сквозной по слепым наборам: ответ / не знаю / не расслышала / мимо) · encoders · finetune · thresholds · newslot · laya_* · live · label" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1010" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c397" value="&lt;b&gt;data/&lt;/b&gt;: authoring.py (suggest_slot, lint, probe_questions) · compile.py (сборка банка, отчёт) · loader.py (load_scenario, load_all, merge audio index) · ontology.py" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1060" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c398" value="&lt;b&gt;Метрики (README)&lt;/b&gt;&lt;br&gt;банк со сплавом: 78.6% top-1; tuned e5: +4.1 п. (80.3%)&lt;br&gt;слепые наборы, tuned, отсечка 0.60: 61.6% ответов, 28.9% «не знаю», 95.6% критичных фактов&lt;br&gt;laya-only: 70.6%, p95 16 мс; thin_rescue: 81.1 → 83.0%&lt;br&gt;tests: 146+ (pytest)" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="960" width="560" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p848" name="8. Данные: входы, выходы, форматы"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c399" value="&lt;b style='font-size:22px'&gt;Модели данных и форматы файлов&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;Что на входе и выходе у каждого компонента&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="60" as="geometry"/></mxCell><mxCell id="c400" value="YAML-каталог traineebox (artifacts/etc/traineebox/catalog) — общий для traineebox и ticketgen" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1150" height="560" as="geometry"/></mxCell><mxCell id="c401" value="&lt;b&gt;types/&amp;lt;code&amp;gt;.yaml&lt;/b&gt; ×51&lt;br&gt;code, title&lt;br&gt;include_common: [group codes]&lt;br&gt;groups: [TagGroup]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="c400"><mxGeometry x="20" y="40" width="250" height="110" as="geometry"/></mxCell><mxCell id="c402" value="&lt;b&gt;TagGroup&lt;/b&gt;&lt;br&gt;code, title&lt;br&gt;selection_mode: single | multi&lt;br&gt;parent_tag: tag code (опц. — группа видна, только если выбран родитель)&lt;br&gt;tags: [Tag{code, title}]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="c400"><mxGeometry x="300" y="40" width="300" height="130" as="geometry"/></mxCell><mxCell id="c403" value="&lt;b&gt;common_tags.yaml&lt;/b&gt;&lt;br&gt;groups: {code → TagGroup}&lt;br&gt;6 общих: access, evacuation, medical_help, offense, threat_people, victims" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="c400"><mxGeometry x="640" y="40" width="240" height="110" as="geometry"/></mxCell><mxCell id="c404" value="&lt;b&gt;services.yaml&lt;/b&gt;&lt;br&gt;services: [{code, title}] (~210)&lt;br&gt;sluzhba_101/102/103/104, fsb, tsemp, ogdts, tsodd, mosvodokanal, moek, metro, …" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="c400"><mxGeometry x="900" y="40" width="230" height="110" as="geometry"/></mxCell><mxCell id="c405" value="&lt;b&gt;routing.yaml&lt;/b&gt; (24 правила)&lt;br&gt;rules:&lt;br&gt;- match: {type: '101'}&lt;br&gt;&amp;nbsp;&amp;nbsp;always: [sluzhba_101]&lt;br&gt;&amp;nbsp;&amp;nbsp;when:&lt;br&gt;&amp;nbsp;&amp;nbsp;- tags_any: [victims_yes, medical_help_yes]&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;add: [sluzhba_102, sluzhba_103]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontFamily=monospace;fontSize=10;" vertex="1" parent="c400"><mxGeometry x="20" y="200" width="380" height="150" as="geometry"/></mxCell><mxCell id="c406" value="&lt;b&gt;Пример types/traffic_accident.yaml&lt;/b&gt;&lt;br&gt;code: traffic_accident&lt;br&gt;title: ДТП&lt;br&gt;include_common: [access, threat_people, medical_help, evacuation]&lt;br&gt;groups:&lt;br&gt;- code: dtp_place · single&lt;br&gt;&amp;nbsp;&amp;nbsp;tags: dtp_road, dtp_yard, dtp_parking, dtp_other&lt;br&gt;- code: dtp_injured · single&lt;br&gt;&amp;nbsp;&amp;nbsp;tags: dtp_injured_yes, dtp_injured_no" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontFamily=monospace;fontSize=10;" vertex="1" parent="c400"><mxGeometry x="420" y="200" width="420" height="170" as="geometry"/></mxCell><mxCell id="c407" value="&lt;b&gt;Карточка происшествия&lt;/b&gt; (эталон = ответ обучающегося)&lt;br&gt;incident_type_code&lt;br&gt;tag_codes[] (тип + общие группы)&lt;br&gt;service_codes[] (recommend = always ∪ when)&lt;br&gt;applicant_last_name / first_name&lt;br&gt;caller_number / dictated_number&lt;br&gt;(+ notes у ответа)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="c400"><mxGeometry x="860" y="200" width="270" height="170" as="geometry"/></mxCell><mxCell id="c408" value="Источник: «Классификатор_происшествий_v_046_24 (МВД + Департамент).xlsx» в корне репо" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10;" vertex="1" parent="c400"><mxGeometry x="20" y="390" width="1110" height="30" as="geometry"/></mxCell><mxCell id="c409" value="&lt;b&gt;Потребители&lt;/b&gt;: traineebox yaml_catalog.go (API /catalog/*, валидация ответов и эталонов, recommend) · ticketgen catalog.py (промпты LLM, recommend, validate_reference)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10;" vertex="1" parent="c400"><mxGeometry x="20" y="430" width="1110" height="40" as="geometry"/></mxCell><mxCell id="c410" value="dispatcher: онтология и сценарии (dispatcher/data)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1200" y="90" width="1180" height="800" as="geometry"/></mxCell><mxCell id="c411" value="&lt;b&gt;ontology/slots.yaml&lt;/b&gt; (91 слот)&lt;br&gt;- id: addr.full&lt;br&gt;&amp;nbsp;&amp;nbsp;label: адрес происшествия&lt;br&gt;&amp;nbsp;&amp;nbsp;kind: value | yesno | description&lt;br&gt;&amp;nbsp;&amp;nbsp;family: addr (по префиксу id)&lt;br&gt;&amp;nbsp;&amp;nbsp;aliases: [адрес, место, …] (старые ключи)&lt;br&gt;&amp;nbsp;&amp;nbsp;fallback: [addr.street, …] (кто отвечает за отсутствующий)&lt;br&gt;&amp;nbsp;&amp;nbsp;questions: [...] (затравки для новых слотов)&lt;br&gt;&amp;nbsp;&amp;nbsp;urge: «адрес» · default_disclosure · since&lt;br&gt;overrides: …" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontFamily=monospace;fontSize=10;" vertex="1" parent="c410"><mxGeometry x="20" y="40" width="360" height="220" as="geometry"/></mxCell><mxCell id="c412" value="&lt;b&gt;scenarios/&amp;lt;id&amp;gt;.json&lt;/b&gt; (97: bilet01..32_call01..03 + demo_pipe)&lt;br&gt;{&lt;br&gt;&amp;nbsp;id: 'bilet04_call01',&lt;br&gt;&amp;nbsp;meta: {situation, address_ref, …},&lt;br&gt;&amp;nbsp;persona: {profile: calm|normal|hard, opening},&lt;br&gt;&amp;nbsp;critical: ['addr.street', 'fire.floor'],&lt;br&gt;&amp;nbsp;facts: [{&lt;br&gt;&amp;nbsp;&amp;nbsp;id: 'fire.floor' (слот или слот#2),&lt;br&gt;&amp;nbsp;&amp;nbsp;slot, numbers: [13], questions?: [...],&lt;br&gt;&amp;nbsp;&amp;nbsp;answers: {plain*, short, confirm, correct},&lt;br&gt;&amp;nbsp;&amp;nbsp;disclosure: volunteered | on_request,&lt;br&gt;&amp;nbsp;&amp;nbsp;requires: ['addr.street']&lt;br&gt;&amp;nbsp;}]&lt;br&gt;}" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontFamily=monospace;fontSize=10;" vertex="1" parent="c410"><mxGeometry x="400" y="40" width="400" height="290" as="geometry"/></mxCell><mxCell id="c413" value="&lt;b&gt;Python-модель&lt;/b&gt; (types.py)&lt;br&gt;Slot · Fact(key, slot, answers, numbers, requires, disclosure, questions, audio) · Profile(max_facts_per_turn, mood_ceiling, idle_turns_to_worry, critical_wait, initiative_cooldown) · Scenario(facts, critical, profile, opening, meta, by_slot, answers_for)&lt;br&gt;Act · Style · Mood · Disclosure · SlotKind" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c410"><mxGeometry x="820" y="40" width="340" height="220" as="geometry"/></mxCell><mxCell id="c414" value="&lt;b&gt;blind/*.txt&lt;/b&gt; (105)&lt;br&gt;слепые наборы реплик оператора по сценарию (~6100 реплик) — для bench.run" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c410"><mxGeometry x="20" y="280" width="360" height="70" as="geometry"/></mxCell><mxCell id="c415" value="&lt;b&gt;gold/live_calls.tsv&lt;/b&gt;&lt;br&gt;реплики с живых звонков (STT GigaAM как есть) + ожидаемый слот (| — любой, * — префикс, ack)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c410"><mxGeometry x="20" y="360" width="360" height="70" as="geometry"/></mxCell><mxCell id="c416" value="&lt;b&gt;build/bank.json&lt;/b&gt; (компилятор)&lt;br&gt;{digest, questio