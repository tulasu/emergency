calls; DELETE /calls/{id}" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;rounded=0;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c422"><mxGeometry x="210" y="340" width="460" height="70" as="geometry"/></mxCell><mxCell id="c440" value="202 {call_id, to, scenario_id, rtp_port}; ARI originate; вызовы /sessions/*" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;rounded=0;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c422"><mxGeometry x="670" y="340" width="470" height="70" as="geometry"/></mxCell><mxCell id="c441" value="&lt;b&gt;dispatcher HTTP&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;rounded=0;fontSize=10;" vertex="1" parent="c422"><mxGeometry x="10" y="410" width="200" height="70" as="geometry"/></mxCell><mxCell id="c442" value="/sessions/open {scenario_id, session_id} · check · partial {session_id,text} · final · cancel · close · /rtp {session_id, scenario_id, audio_b64 alaw}" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;rounded=0;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c422"><mxGeometry x="210" y="410" width="460" height="70" as="geometry"/></mxCell><mxCell id="c443" value="{session_id, opening} · Reply{text,audio_id,style,mood} · {stop_audio_id} · {audio_b64} · /health {ok, scenarios, sessions}" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;rounded=0;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c422"><mxGeometry x="670" y="410" width="470" height="70" as="geometry"/></mxCell><mxCell id="c444" value="&lt;b&gt;dispatcher AudioSocket&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;rounded=0;fontSize=10;" vertex="1" parent="c422"><mxGeometry x="10" y="480" width="200" height="70" as="geometry"/></mxCell><mxCell id="c445" value="TCP-фреймы SLIN 8 кГц от Asterisk" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;rounded=0;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c422"><mxGeometry x="210" y="480" width="460" height="70" as="geometry"/></mxCell><mxCell id="c446" value="SLIN 8 кГц ответа (20 мс кадры), logs data/calls" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;rounded=0;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c422"><mxGeometry x="670" y="480" width="470" height="70" as="geometry"/></mxCell><mxCell id="c447" value="&lt;b&gt;Asterisk&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;rounded=0;fontSize=10;" vertex="1" parent="c422"><mxGeometry x="10" y="550" width="200" height="70" as="geometry"/></mxCell><mxCell id="c448" value="SIP REGISTER/INVITE софтфона, ARI originate" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;rounded=0;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c422"><mxGeometry x="210" y="550" width="460" height="70" as="geometry"/></mxCell><mxCell id="c449" value="SIP-звонок на софтфон, AudioSocket к Python" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;rounded=0;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c422"><mxGeometry x="670" y="550" width="470" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p849" name="9. Замечания и риски"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c450" value="&lt;b style='font-size:22px'&gt;Что бросилось в глаза при изучении кода&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;Не баг-репорт с проверкой, а наблюдения по чтению; стоит перепроверить перед исправлением&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="60" as="geometry"/></mxCell><mxCell id="c451" value="&lt;b&gt;Интеграция&lt;/b&gt;&lt;br&gt;traineebox/ticketgen и dispatcher не связаны: билет (tickets.body — свободный текст + эталон по каталогу) и сценарий dispatcher (JSON с фактами по слотам онтологии) — разные модели. Голосовой звонок не привязан к попытке и не пишет ничего в БД." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="560" height="170" as="geometry"/></mxCell><mxCell id="c452" value="&lt;b&gt;Деплой&lt;/b&gt;&lt;br&gt;Закоммиченный docker-compose.yml расходится с config/system.cue (нет ticketgen). traineebox не контейнеризован (нет Dockerfile, нет в compose)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="600" y="90" width="560" height="170" as="geometry"/></mxCell><mxCell id="c453" value="&lt;b&gt;Порты&lt;/b&gt;&lt;br&gt;orchestrator (:8080) и traineebox (TRAINEEBOX_HTTP_ADDR=:8080) по умолчанию конфликтуют на одном хосте (dispatcher стек в host network)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1180" y="90" width="560" height="170" as="geometry"/></mxCell><mxCell id="c454" value="&lt;b&gt;Сеть LLM&lt;/b&gt;&lt;br&gt;ticketgen в bridge-сети обращается к host.docker.internal:8081 — на Linux нужен extra_hosts host-gateway, а llama слушает только 127.0.0.1 → недоступна из контейнера. Модель в dev.cue (Qwen3-1.7B) ≠ модели в compose llama (Qwen3-4B-Instruct)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="560" height="170" as="geometry"/></mxCell><mxCell id="c455" value="&lt;b&gt;AudioSocket-роутинг&lt;/b&gt;&lt;br&gt;serve.py берёт последнюю открытую сессию (next(reversed(SVC.sessions))), а не по call_id → при параллельных звонках аудио попадёт не в ту сессию. UUID в extensions.conf захардкожен." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="600" y="280" width="560" height="170" as="geometry"/></mxCell><mxCell id="c456" value="&lt;b&gt;RTP-помпа&lt;/b&gt;&lt;br&gt;orchestrator UDP-помпа + /rtp — эхо-путь v1; фактический звук идёт через AudioSocket. DELETE /calls не рвёт канал (ARI delete не вызывается)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1180" y="280" width="560" height="170" as="geometry"/></mxCell><mxCell id="c457" value="&lt;b&gt;Глобальный LOCK&lt;/b&gt;&lt;br&gt;serve.py сериализует все HTTP-запросы под одним LOCK — пропускная способность воркера = 1 запрос одновременно." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="560" height="170" as="geometry"/></mxCell><mxCell id="c458" value="&lt;b&gt;Approve не атомарен&lt;/b&gt;&lt;br&gt;ApproveJob: Tickets.CreateWithReference, затем SaveCAS джоба — разные транзакции. Проигрыш CAS (параллельный approve/cancel) оставит опубликованный билет без связи с job (дубликаты)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="600" y="470" width="560" height="170" as="geometry"/></mxCell><mxCell id="c459" value="&lt;b&gt;Дублирование каталога&lt;/b&gt;&lt;br&gt;Логика каталога (видимость групп по parent_tag, recommend, валидация) реализована дважды: Go (yaml_catalog.go) и Python (catalog.py) — риск расхождения." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1180" y="470" width="560" height="170" as="geometry"/></mxCell><mxCell id="c460" value="&lt;b&gt;Миграция 00005&lt;/b&gt;&lt;br&gt;Удаляет справочники и ЧИСТИТ все эталоны и ответы попыток (DELETE FROM …) — на проде это потеря данных; down-миграция не восстанавливает данные." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="560" height="170" as="geometry"/></mxCell><mxCell id="c461" value="&lt;b&gt;Секреты по умолчанию&lt;/b&gt;&lt;br&gt;TRAINEEBOX_SESSION_SECRET='dev-session-secret-change-me', admin/adminadmin, postgres emergency/emergency, ARI/PJSIP пароли в конфигах в репо." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="600" y="660" width="560" height="170" as="geometry"/></mxCell><mxCell id="c462" value="&lt;b&gt;Caddy&lt;/b&gt;&lt;br&gt;Только заглушка «emergency edge ok» — reverse proxy на traineebox не настроен." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1180" y="660" width="560" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p850" name="10. dispatcher: слоты, сценарии, факты, формулировки"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c463" value="&lt;b style='font-size:22px'&gt;dispatcher — как связаны слоты, сценарии, факты и формулировки&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;Главная идея: формулировки вопросов принадлежат СЛОТУ, а не факту. Все сценарии пополняют один общий банк; ответ всегда берётся из факта конкретного сценария.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="60" as="geometry"/></mxCell><mxCell id="c464" value="ОНТОЛОГИЯ · data/ontology/slots.yaml · 91 слот, общий для всех сценариев" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="520" height="560" as="geometry"/></mxCell><mxCell id="c465" value="&lt;b&gt;Слот fire.floor&lt;/b&gt;&lt;br&gt;label: этаж возгорания&lt;br&gt;kind: value · family: fire&lt;br&gt;aliases: [этаж_возгорания, этаж_задымления]&lt;br&gt;urge: «этаж»" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c464"><mxGeometry x="20" y="40" width="480" height="100" as="geometry"/></mxCell><mxCell id="c466" value="&lt;b&gt;Слот addr.full&lt;/b&gt;&lt;br&gt;label: адрес происшествия · family: addr&lt;br&gt;fallback: [addr.street, addr.spot, addr.landmark, …]&lt;br&gt;urge: «адрес»" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c464"><mxGeometry x="20" y="150" width="480" height="90" as="geometry"/></mxCell><mxCell id="c467" value="&lt;b&gt;Слот addr.street&lt;/b&gt; · fallback: [addr.full, addr.refined]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c464"><mxGeometry x="20" y="250" width="480" height="40" as="geometry"/></mxCell><mxCell id="c468" value="&lt;b&gt;Поля слота&lt;/b&gt;&lt;br&gt;• &lt;b&gt;id&lt;/b&gt; — «семья.тема»; семья = префикс (для эллипсиса «а корпус?»)&lt;br&gt;• &lt;b&gt;kind&lt;/b&gt;: value (в карточку) · yesno · description&lt;br&gt;• &lt;b&gt;aliases&lt;/b&gt; — старые русские ключи фактов → этот слот&lt;br&gt;• &lt;b&gt;fallback&lt;/b&gt; — кто отвечает, если этого слота у заявителя нет&lt;br&gt;• &lt;b&gt;questions&lt;/b&gt; — затравки ТОЛЬКО для слотов, которых ещё нет в корпусе&lt;br&gt;• &lt;b&gt;urge&lt;/b&gt; — как заявитель сам напомнит о критичном слоте&lt;br&gt;• &lt;b&gt;default_disclosure&lt;/b&gt;, since&lt;br&gt;&lt;b&gt;overrides&lt;/b&gt; (внизу файла): «сценарий:ключ» → слот для спорных случаев" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="c464"><mxGeometry x="20" y="300" width="480" height="240" as="geometry"/></mxCell><mxCell id="c469" value="СЦЕНАРИИ · data/scenarios/*.json · 97 шт. (32 билета × 3 вызова + demo)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="600" y="90" width="900" height="760" as="geometry"/></mxCell><mxCell id="c470" value="bilet04_call01 — «горит балкон на 13-м этаже»" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="c469"><mxGeometry x="20" y="40" width="860" height="290" as="geometry"/></mxCell><mxCell id="c471" value="&lt;b&gt;шапка сценария&lt;/b&gt;&lt;br&gt;meta.situation, address_ref&lt;br&gt;persona: profile=calm, opening «Алло, тут балкон горит…»&lt;br&gt;critical: [addr.street, addr.landmark, victim.present, fire.floor]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c470"><mxGeometry x="10" y="30" width="330" height="110" as="geometry"/></mxCell><mxCell id="c472" value="&lt;b&gt;Факт fire.floor&lt;/b&gt; (id = слот)&lt;br&gt;slot: fire.floor · numbers: [13]&lt;br&gt;&lt;b&gt;questions&lt;/b&gt;: «на каком этаже горит», «этаж возгорания», «какой этаж в огне» … (10)&lt;br&gt;&lt;b&gt;answers&lt;/b&gt;:&lt;br&gt;&amp;nbsp;plain «На тринадцатом этаже, балкон весь в огне.»&lt;br&gt;&amp;nbsp;short «Тринадцатый я же говорю.»&lt;br&gt;&amp;nbsp;confirm «Да, тринадцатый.»&lt;br&gt;&amp;nbsp;correct «Нет, тринадцатый горит! …»" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c470"><mxGeometry x="360" y="30" width="490" height="150" as="geometry"/></mxCell><mxCell id="c473" value="&lt;b&gt;Факт building.floors&lt;/b&gt; · numbers [14] · &lt;b&gt;disclosure: on_request&lt;/b&gt; (только по прямому вопросу)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c470"><mxGeometry x="360" y="190" width="490" height="40" as="geometry"/></mxCell><mxCell id="c474" value="&lt;b&gt;Факт addr.landmark&lt;/b&gt; · &lt;b&gt;requires: [addr.street]&lt;/b&gt; (не раньше улицы) · … всего 12 фактов" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c470"><mxGeometry x="360" y="240" width="490" height="40" as="geometry"/></mxCell><mxCell id="c475" value="нет факта building.gas? → есть, on_request.&lt;br&gt;Нет факта caller.age → на вопрос о возрасте «не знаю»" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;dashed=1;" vertex="1" parent="c470"><mxGeometry x="10" y="150" width="330" height="60" as="geometry"/></mxCell><mxCell id="c476" value="&lt;b&gt;bilet05_call01&lt;/b&gt; — «горит окно на 9 этаже»&lt;br&gt;&lt;b&gt;Факт fire.floor&lt;/b&gt; · numbers [9]&lt;br&gt;questions: «На каком этаже горит окно?», «Где по высоте вы видите огонь?» …&lt;br&gt;answers.plain «На девятом этаже горит.»" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c469"><mxGeometry x="20" y="350" width="420" height="110" as="geometry"/></mxCell><mxCell id="c477" value="&lt;b&gt;bilet08_call01&lt;/b&gt; — «задымление в ТЦ»&lt;br&gt;&lt;b&gt;Факт fire.floor&lt;/b&gt; · numbers [-1]&lt;br&gt;questions: «На каком этаже задымление?», «Какой уровень ТЦ задымлён?» …&lt;br&gt;answers.plain «На минус первом этаже.»" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c469"><mxGeometry x="460" y="350" width="420" height="110" as="geometry"/></mxCell><mxCell id="c478" value="&lt;b&gt;Факт — поля&lt;/b&gt;&lt;br&gt;• &lt;b&gt;id&lt;/b&gt;: слот; если слот делят несколько фактов — слот#2, слот#3 (отвечают вместе: «отёк руки» + «отёк ноги»)&lt;br&gt;• &lt;b&gt;slot&lt;/b&gt; — ссылка на онтологию (обязательна)&lt;br&gt;• &lt;b&gt;answers&lt;/b&gt;: plain* / short / confirm / correct — ЕДИНСТВЕННЫЙ источник текста ответа&lt;br&gt;• &lt;b&gt;numbers&lt;/b&gt; — числа значения: если оператор назвал другое → стиль correct&lt;br&gt;• &lt;b&gt;questions&lt;/b&gt; — формулировки (можно не писать: их даст корпус)&lt;br&gt;• &lt;b&gt;disclosure&lt;/b&gt;: volunteered | on_request · &lt;b&gt;requires&lt;/b&gt;: [ключи фактов]&lt;br&gt;• audio — пути к предрендеренным wav (из audio/index.json)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="c469"><mxGeometry x="20" y="480" width="860" height="170" as="geometry"/></mxCell><mxCell id="c479" value="&lt;b&gt;Кардинальности&lt;/b&gt;: Сценарий 1 — * Факт · Слот 1 — * Факт (из разных сценариев) · Факт 1 — * формулировка · в сценарии обычно 1 факт на слот" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=11;" vertex="1" parent="c469"><mxGeometry x="20" y="670" width="860" height="50" as="geometry"/></mxCell><mxCell id="c480" value="БАНК ФОРМУЛИРОВОК · load_all() → data/build/bank.json · один на весь корпус" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1560" y="90" width="800" height="560" as="geometry"/></mxCell><mxCell id="c481" value="&lt;b&gt;bank[fire.floor]&lt;/b&gt; — 23 формулировки&lt;br&gt;из bilet04 + bilet05 + bilet08 (+ затравки slots.yaml)&lt;br&gt;дубликаты убраны (регистр, ё→е, пунктуация)&lt;br&gt;у каждой запомнен сценарий-источник (для --fresh и bench.loo)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c480"><mxGeometry x="20" y="40" width="760" height="90" as="geometry"/></mxCell><mxCell id="c482" value="&lt;b&gt;bank[addr.full]&lt;/b&gt; — 466 формулировок (самый «населённый»)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c480"><mxGeometry x="20" y="140" width="760" height="36" as="geometry"/></mxCell><mxCell id="c483" value="&lt;b&gt;bank[env.weather]&lt;/b&gt; — ~5 (бедный слот: узнаётся плохо, дописывать формулировки)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c480"><mxGeometry x="20" y="186" width="760" height="36" as="geometry"/></mxCell><mxCell id="c484" value="… 88 слотов с формулировками" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=11;" vertex="1" parent="c480"><mxGeometry x="20" y="232" width="760" height="30" as="geometry"/></mxCell><mxCell id="c485" value="&lt;b&gt;Как используется&lt;/b&gt;&lt;br&gt;• &lt;b&gt;LexicalBank&lt;/b&gt;: леммы реплики ∩ леммы формулировок, вес по обратной частоте&lt;br&gt;• &lt;b&gt;VectorBank&lt;/b&gt;: косинус эмбеддингов e5 (дообученный — на этих же формулировках)&lt;br&gt;• сплав двух оценок, вычет «фона» слота (форы населённых)&lt;br&gt;• оценка по ВСЕМ слотам; уверенность = разрыв до 2-го кандидата с другим ответом&lt;br&gt;&lt;br&gt;&lt;b&gt;Почему так&lt;/b&gt;: новый сценарий получает формулировки даром — автор пишет только факты и ответы. Медиана 28 формулировок на слот против ~9 написанных руками на факт." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="c480"><mxGeometry x="20" y="275" width="760" height="200" as="geometry"/></mxCell><mxCell id="c486" value="&lt;b&gt;НЕ входят в банк&lt;/b&gt; (только проверка): blind/*.txt — слепые реплики (bench.run) · gold/live_calls.tsv — живые звонки с размеченным слотом" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c480"><mxGeometry x="20" y="490" width="760" height="50" as="geometry"/></mxCell><mxCell id="c487" value="slot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="c472" target="c465"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c488" value="slot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="c476" target="c465"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c489" value="slot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="c477" target="c465"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c490" value="questions →" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#b85450;dashed=1;strokeWidth=2;" edge="1" parent="1" source="c472" target="c481"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c491" value="questions →" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#b85450;dashed=1;strokeWidth=2;" edge="1" parent="1" source="c476" target="c481"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c492" value="questions →" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#b85450;dashed=1;strokeWidth=2;" edge="1" parent="1" source="c477" target="c481"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c493" value="fallback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c466" target="c467"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="285"/><mxPoint x="560" y="360"/></Array></mxGeometry></mxCell><mxCell id="c494" value="В РАНТАЙМЕ: реплика оператора → ответ заявителя (сценарий bilet04_call01)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="920" width="2340" height="420" as="geometry"/></mxCell><mxCell id="c495" value="&lt;b&gt;1. Реплика&lt;/b&gt;&lt;br&gt;«А на каком этаже пожар?»" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;fontSize=11;" vertex="1" parent="c494"><mxGeometry x="20" y="40" width="350" height="110" as="geometry"/></mxCell><mxCell id="c496" value="&lt;b&gt;2. Правила&lt;/b&gt;&lt;br&gt;акт: ask / confirm / assert / speech_act; эллипсис «а корпус?»" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=11;" vertex="1" parent="c494"><mxGeometry x="405" y="40" width="350" height="110" as="geometry"/></mxCell><mxCell id="c497" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c494" source="c495" target="c496"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c498" value="&lt;b&gt;3. Банк → слот&lt;/b&gt;&lt;br&gt;сравнение со ВСЕМИ слотами&lt;br&gt;→ fire.floor" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;fontSize=11;" vertex="1" parent="c494"><mxGeometry x="790" y="40" width="350" height="110" as="geometry"/></mxCell><mxCell id="c499" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c494" source="c496" target="c498"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c500" value="&lt;b&gt;4. Слот → факт сценария&lt;/b&gt;&lt;br&gt;scenario.by_slot[fire.floor] → факт fire.floor&lt;br&gt;(или answers_for по fallback)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;fontSize=11;" vertex="1" parent="c494"><mxGeometry x="1175" y="40" width="350" height="110" as="geometry"/></mxCell><mxCell id="c501" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c494" source="c498" target="c500"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c502" value="&lt;b&gt;5. Политика → стиль&lt;/b&gt;&lt;br&gt;первый раз → plain; повтор → short; «тринадцатый, верно?» → confirm; «четырнадцатый?» → correct (numbers)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=11;" vertex="1" parent="c494"><mxGeometry x="1560" y="40" width="350" height="110" as="geometry"/></mxCell><mxCell id="c503" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c494" source="c500" target="c502"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c504" value="&lt;b&gt;6. Ответ = answers[стиль]&lt;/b&gt;&lt;br&gt;«На тринадцатом этаже, балкон весь в огне.» + audio_id" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=11;" vertex="1" parent="c494"><mxGeometry x="1945" y="40" width="350" height="110" as="geometry"/></mxCell><mxCell id="c505" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c494" source="c502" target="c504"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c506" value="&lt;b&gt;Слот не распознан&lt;/b&gt; (нет смысловых слов, topical=0)&lt;br&gt;→ &lt;b&gt;mishear&lt;/b&gt;: «Не расслышала, повторите»" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;fontSize=11;" vertex="1" parent="c494"><mxGeometry x="405" y="200" width="350" height="70" as="geometry"/></mxCell><mxCell id="c507" value="&lt;b&gt;Слот понят, но факта с ним в сценарии нет&lt;/b&gt;&lt;br&gt;(напр. «сколько лет пострадавшему?»)&lt;br&gt;→ &lt;b&gt;dont_know&lt;/b&gt;: «Не знаю» — это ПРАВИЛЬНЫЙ ответ&lt;br&gt;(с --improv — короткая фраза LLM без новых фактов)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;fontSize=11;" vertex="1" parent="c494"><mxGeometry x="790" y="200" width="350" height="100" as="geometry"/></mxCell><mxCell id="c508" value="&lt;b&gt;Факт есть, но requires не раскрыт&lt;/b&gt; (addr.landmark до addr.street)&lt;br&gt;→ dont_know" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;fontSize=11;" vertex="1" parent="c494"><mxGeometry x="1175" y="200" width="350" height="70" as="geometry"/></mxCell><mxCell id="c509" value="&lt;b&gt;Оператор долго не спрашивает critical-слот&lt;/b&gt;&lt;br&gt;→ заявитель сам напомнит (urge слота)&lt;br&gt;&lt;b&gt;on_request&lt;/b&gt;-факт сам не выдаётся никогда" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;fontSize=11;" vertex="1" parent="c494"><mxGeometry x="1560" y="200" width="350" height="80" as="geometry"/></mxCell><mxCell id="c510" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="c494" source="c498" target="c506"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c511" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="c494" source="c500" target="c507"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c512" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="c494" source="c500" target="c508"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1350" y="170"/></Array></mxGeometry></mxCell><mxCell id="c513" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="c494" source="c502" target="c509"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c514" value="Текст ответа никогда не генерируется моделью (кроме опц. improv вместо «не знаю») — модели только классифицируют реплику в слот." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="c494"><mxGeometry x="20" y="330" width="1500" height="30" as="geometry"/></mxCell><mxCell id="c515" value='&lt;b&gt;Как завести новую ситуацию&lt;/b&gt;&lt;br&gt;1. Написать сценарий: persona.opening, critical, факты (slot + answers.plain, по желанию short/confirm/correct, numbers, disclosure, requires). Формулировки НЕ писать.&lt;br&gt;2. Не знаешь слот → &lt;code&gt;cli suggest "какой этаж горит"&lt;/code&gt;&lt;br&gt;3. &lt;code&gt;cli lint &amp;lt;сценарий&amp;gt;&lt;/code&gt; — какие факты банк не достаёт → только им дописать questions&lt;br&gt;4. Темы нет в онтологии → новый слот в slots.yaml с 5+ затравками (бедные слоты узнаются в ~15–18%)&lt;br&gt;5. &lt;code&gt;bench.run&lt;/code&gt; / &lt;code&gt;bench.loo&lt;/code&gt; — не просело ли качество; &lt;code&gt;cli chat &amp;lt;сценарий&amp;gt; --fresh&lt;/code&gt; — как система видит сценарий «впервые»' style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="1370" width="1150" height="170" as="geometry"/></mxCell><mxCell id="c516" value="&lt;b&gt;Старый формат&lt;/b&gt; (key/group/value_numbers, русские ключи) читается через aliases/overrides; перевести — tools/migrate_scenario.py.&lt;br&gt;&lt;b&gt;Первоисточник&lt;/b&gt; сценариев — core/bilets.md: 32 билета × 3 вызова.&lt;br&gt;&lt;b&gt;Аудио&lt;/b&gt;: tools/synth_audio.py рендерит каждый answers[стиль] в data/audio/a/&amp;lt;сценарий&amp;gt;/&amp;lt;факт&amp;gt;/&amp;lt;стиль&amp;gt;.wav" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1200" y="1370" width="1160" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p851" name="11. traineebox: билет, карточка, artifacts"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c517" value="&lt;b style='font-size:22px'&gt;traineebox — что такое билет (ticket), его карточки и каталог в artifacts/&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;Билет = задание с текстом сценария + ЭТАЛОННАЯ карточка происшествия. Обучающийся в попытке заполняет СВОЮ карточку; submit сравнивает её с эталоном. Все коды карточки — из YAML-каталога в artifacts/.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="60" as="geometry"/></mxCell><mxCell id="c518" value="БИЛЕТ (tickets) — задание для группы" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="560" height="420" as="geometry"/></mxCell><mxCell id="c519" value="&lt;b&gt;group_id&lt;/b&gt; — билет принадлежит группе; видят участники группы&lt;br&gt;&lt;b&gt;title&lt;/b&gt; — заголовок (≤256)&lt;br&gt;&lt;b&gt;body&lt;/b&gt; — текст сценария: что случилось, где, кто звонит (при генерации = scenario_text)&lt;br&gt;&lt;b&gt;created_by&lt;/b&gt; — owner/teacher группы или admin" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c518"><mxGeometry x="10" y="30" width="540" height="110" as="geometry"/></mxCell><mxCell id="c520" value="&lt;b&gt;Настройки доступа&lt;/b&gt; (все необязательны)&lt;br&gt;• available_from … available_until — окно, когда можно начать попытку&lt;br&gt;• max_attempts — сколько завершённых попыток разрешено&lt;br&gt;• duration_seconds — таймер попытки → deadline_at; после него попытка timed_out" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c518"><mxGeometry x="10" y="150" width="540" height="100" as="geometry"/></mxCell><mxCell id="c521" value="&lt;b&gt;Как появляется&lt;/b&gt;&lt;br&gt;① вручную: POST /groups/{id}/tickets → PUT /tickets/{id}/reference&lt;br&gt;② генерацией: POST generation-jobs {prompt} → ticketgen (LLM) → ready → PATCH (правка) → approve → билет + эталон одной операцией" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c518"><mxGeometry x="10" y="260" width="540" height="90" as="geometry"/></mxCell><mxCell id="c522" value="Без эталона билет существует, но submit попытки вернёт ошибку (ErrNoReferenceAnswer)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b85450;verticalAlign=middle;fontSize=10;" vertex="1" parent="c518"><mxGeometry x="10" y="360" width="540" height="45" as="geometry"/></mxCell><mxCell id="c523" value="ЭТАЛОННАЯ КАРТОЧКА (ticket_reference_answers + reference_answer_tags/services) — 1:1 с билетом" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="620" y="90" width="820" height="420" as="geometry"/></mxCell><mxCell id="c524" value="&lt;b&gt;incident_type_code&lt;/b&gt; — тип происшествия (обязателен), напр. «101»&lt;br&gt;&lt;b&gt;tag_codes[]&lt;/b&gt; — теги типа + общие теги (признаки, где, пострадавшие, доступ…)&lt;br&gt;&lt;b&gt;service_codes[]&lt;/b&gt; — какие службы направить&lt;br&gt;&lt;b&gt;applicant_last_name / applicant_first_name&lt;/b&gt; — ФИО заявителя&lt;br&gt;&lt;b&gt;caller_number&lt;/b&gt; — номер, с которого звонят&lt;br&gt;&lt;b&gt;dictated_number&lt;/b&gt; — номер, который заявитель продиктовал" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c523"><mxGeometry x="10" y="30" width="800" height="120" as="geometry"/></mxCell><mxCell id="c525" value="&lt;b&gt;Пример&lt;/b&gt; (пожар на улице, горит мусор)&lt;br&gt;type: 101&lt;br&gt;tags: where_street → street_flame_smoke → burn_trash, medical_help_no, evacuation_no&lt;br&gt;services: sluzhba_101 (+ по routing: при medical_help_yes → sluzhba_103, tsemp; при gas_yes → sluzhba_104 …)&lt;br&gt;ФИО: Иванов Пётр · caller 79161234567 · dictated 79167654321" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;fontFamily=monospace;" vertex="1" parent="c523"><mxGeometry x="10" y="160" width="800" height="110" as="geometry"/></mxCell><mxCell id="c526" value="&lt;b&gt;Валидация при сохранении&lt;/b&gt; (и эталона, и ответа)&lt;br&gt;• тип существует в каталоге; теги без типа запрещены&lt;br&gt;• каждый тег — из групп ЭТОГО типа (включая include_common)&lt;br&gt;• группа с parent_tag видна только если родительский тег выбран; в скрытой группе теги запрещены&lt;br&gt;• single-группа — не больше одного тега (multi — сколько угодно)&lt;br&gt;• service_codes должны существовать в services.yaml" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="c523"><mxGeometry x="10" y="280" width="800" height="130" as="geometry"/></mxCell><mxCell id="c527" value="КАРТОЧКА ОБУЧАЮЩЕГОСЯ (ticket_attempts + attempt_answers + tags/services)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1480" y="90" width="880" height="420" as="geometry"/></mxCell><mxCell id="c528" value="&lt;b&gt;Попытка&lt;/b&gt;: attempt_no, status in_progress → submitted | timed_out, started_at, deadline_at, finished_at, &lt;b&gt;score 1..100&lt;/b&gt;&lt;br&gt;Только student группы; одна in_progress на билет; лимит max_attempts; окно доступности" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c527"><mxGeometry x="10" y="30" width="860" height="70" as="geometry"/></mxCell><mxCell id="c529" value="&lt;b&gt;Ответ&lt;/b&gt; (черновик, PATCH /attempts/{id}/answer — сохраняется сколько угодно раз)&lt;br&gt;те же поля, что у эталона, но тип может быть пустым (NULL)&lt;br&gt;+ &lt;b&gt;notes&lt;/b&gt; — свободные заметки ≤1000 символов (в оценке не участвуют)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c527"><mxGeometry x="10" y="110" width="860" height="80" as="geometry"/></mxCell><mxCell id="c530" value="&lt;b&gt;Submit → оценка&lt;/b&gt; (scoring.Score)&lt;br&gt;компоненты с равным весом:&lt;br&gt;☐ тип совпал · ☐ множество тегов совпало целиком · ☐ множество служб совпало целиком&lt;br&gt;☐ фамилия · ☐ имя · ☐ caller_number · ☐ dictated_number — только если заполнены в эталоне&lt;br&gt;score = совпавших × 100 / всего, минимум 1&lt;br&gt;&lt;i&gt;Пример: 7 компонентов, ошибка только в тегах → 6·100/7 = 85&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="c527"><mxGeometry x="10" y="200" width="860" height="140" as="geometry"/></mxCell><mxCell id="c531" value="Сравнение строгое: один лишний/пропущенный тег = весь компонент «теги» не засчитан. Строки сравниваются как есть (регистр, пробелы, формат номера важны)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b85450;verticalAlign=middle;fontSize=10;" vertex="1" parent="c527"><mxGeometry x="10" y="350" width="860" height="55" as="geometry"/></mxCell><mxCell id="c532" value="submit: сравнение" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=2;" edge="1" parent="1" source="c523" target="c527"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1030" y="540"/><mxPoint x="1920" y="540"/></Array></mxGeometry></mxCell><mxCell id="c533" value="Из чего собирается карточка: дерево тегов типа (types/101.yaml, фрагмент)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="1420" height="470" as="geometry"/></mxCell><mxCell id="c534" value="&lt;b&gt;Тип 101&lt;/b&gt; (incident_type)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=10;" vertex="1" parent="c533"><mxGeometry x="20" y="190" width="180" height="44" as="geometry"/></mxCell><mxCell id="c535" value="&lt;b&gt;группа where «Где»&lt;/b&gt;&lt;br&gt;single" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10;" vertex="1" parent="c533"><mxGeometry x="250" y="60" width="230" height="44" as="geometry"/></mxCell><mxCell id="c536" value="тег where_street «Улица»" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=10;" vertex="1" parent="c533"><mxGeometry x="520" y="30" width="200" height="44" as="geometry"/></mxCell><mxCell id="c537" value="тег where_transport «Транспорт»" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=10;" vertex="1" parent="c533"><mxGeometry x="520" y="90" width="200" height="44" as="geometry"/></mxCell><mxCell id="c538" value="where_home / where_building / where_hazard" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=10;" vertex="1" parent="c533"><mxGeometry x="520" y="150" width="200" height="44" as="geometry"/></mxCell><mxCell id="c539" value="&lt;b&gt;группа fire_sign_street&lt;/b&gt; single&lt;br&gt;parent_tag: where_street" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10;" vertex="1" parent="c533"><mxGeometry x="770" y="30" width="230" height="44" as="geometry"/></mxCell><mxCell id="c540" value="&lt;b&gt;группа fire_sign_transport&lt;/b&gt;&lt;br&gt;parent_tag: where_transport" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10;" vertex="1" parent="c533"><mxGeometry x="770" y="100" width="230" height="44" as="geometry"/></mxCell><mxCell id="c541" value="тег street_flame_smoke&lt;br&gt;«Открытое пламя / Дым»" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=10;" vertex="1" parent="c533"><mxGeometry x="1040" y="30" width="200" height="44" as="geometry"/></mxCell><mxCell id="c542" value="&lt;b&gt;группа street_burning&lt;/b&gt; single&lt;br&gt;parent_tag: street_flame_smoke&lt;br&gt;burn_trash, burn_grass, burn_park, burn_forest…" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10;" vertex="1" parent="c533"><mxGeometry x="1040" y="100" width="360" height="44" as="geometry"/></mxCell><mxCell id="c543" value="&lt;b&gt;прочие группы типа&lt;/b&gt;: у 101 свои — access (multi), medical_help, evacuation, gasification (gas_yes/no/unknown)…&lt;br&gt;у других типов — через include_common из common_tags.yaml (напр. traffic_accident: access, threat_people, medical_help, evacuation)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10;" vertex="1" parent="c533"><mxGeometry x="250" y="250" width="1120" height="44" as="geometry"/></mxCell><mxCell id="c544" value="&lt;b&gt;службы&lt;/b&gt; = routing.yaml[type=101]: always [sluzhba_101]&lt;br&gt;+ when tags_any [medical_help_yes] → add [sluzhba_103, tsemp]; [gas_yes] → [sluzhba_104]; [has_offense] → [sluzhba_102] …" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10;" vertex="1" parent="c533"><mxGeometry x="250" y="340" width="1120" height="44" as="geometry"/></mxCell><mxCell id="c545" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c533" source="c534" target="c535"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c546" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c533" source="c535" target="c536"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c547" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c533" source="c535" target="c537"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c548" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c533" source="c535" target="c538"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c549" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c533" source="c536" target="c539"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c550" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c533" source="c537" target="c540"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c551" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c533" source="c539" target="c541"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c552" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c533" source="c541" target="c542"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c553" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c533" source="c534" target="c543"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c554" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c533" source="c534" target="c544"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c555" value="Вложенность через &lt;b&gt;parent_tag&lt;/b&gt;: выбрал «Улица» → открылась группа «Признак пожара (улица)» → выбрал «Пламя/Дым» → открылась «Что горит». UI должен показывать группы по мере выбора. GET /catalog/incident-types/{type}/tags отдаёт плоский список групп с parent_tag_code; GET /catalog/recommend?type=&amp;amp;tags= — рекомендованные службы." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="c533"><mxGeometry x="20" y="405" width="1380" height="60" as="geometry"/></mxCell><mxCell id="c556" value="artifacts/ — конфигурационные файлы, которые монтируются в сервисы" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1480" y="580" width="880" height="760" as="geometry"/></mxCell><mxCell id="c557" value="&lt;b&gt;Что это&lt;/b&gt;&lt;br&gt;artifacts/ — зеркало корня файловой системы сервера для dev-окружения. В CUE: &lt;code&gt;config.root&lt;/code&gt;, по умолчанию «/» (прод), в dev.cue = «./artifacts». Пути строятся как &lt;code&gt;{root}/etc/…&lt;/code&gt;:&lt;br&gt;• dev: ./artifacts/etc/traineebox/catalog&lt;br&gt;• прод: /etc/traineebox/catalog&lt;br&gt;Это НЕ результаты сборки — это данные/конфиги, которые версионируются в git." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="c556"><mxGeometry x="10" y="30" width="860" height="150" as="geometry"/></mxCell><mxCell id="c558" value="&lt;b&gt;artifacts/etc/&lt;/b&gt;&lt;br&gt;├─ &lt;b&gt;caddy/Caddyfile&lt;/b&gt; → caddy:/etc/caddy/Caddyfile:ro (сейчас заглушка «emergency edge ok»)&lt;br&gt;└─ &lt;b&gt;traineebox/catalog/&lt;/b&gt; — справочник происшествий (из «Классификатор_происшествий_v_046_24….xlsx»)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;├─ &lt;b&gt;types/*.yaml&lt;/b&gt; — 51 тип: code, title, include_common, groups[] с тегами и parent_tag&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;├─ &lt;b&gt;common_tags.yaml&lt;/b&gt; — 6 общих групп тегов для include_common&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;├─ &lt;b&gt;services.yaml&lt;/b&gt; — ~210 экстренных/городских служб {code, title}&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;└─ &lt;b&gt;routing.yaml&lt;/b&gt; — 24 правила: тип → always[] + when{tags_any → add[]}" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fontFamily=monospace;" vertex="1" parent="c556"><mxGeometry x="10" y="190" width="860" height="180" as="geometry"/></mxCell><mxCell id="c559" value="&lt;b&gt;traineebox&lt;/b&gt;&lt;br&gt;TRAINEEBOX_CATALOG_PATH или автопоиск artifacts/etc/traineebox/catalog вверх от CWD / бинаря (маркер: services.yaml)&lt;br&gt;грузит в память при старте" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=10;" vertex="1" parent="c556"><mxGeometry x="10" y="390" width="420" height="110" as="geometry"/></mxCell><mxCell id="c560" value="&lt;b&gt;ticketgen&lt;/b&gt;&lt;br&gt;том {root}/etc/traineebox/catalog → /catalog:ro&lt;br&gt;TICKETGEN_CATALOG_PATH=/catalog&lt;br&gt;грузит при старте" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=10;" vertex="1" parent="c556"><mxGeometry x="450" y="390" width="420" height="110" as="geometry"/></mxCell><mxCell id="c561" value="&lt;b&gt;Важно&lt;/b&gt;&lt;br&gt;• Каталог читается один раз при старте → после правки YAML нужен рестарт traineebox и ticketgen&lt;br&gt;• В БД хранятся только КОДЫ (TEXT, без FK, миграция 00005) → переименование/удаление кода ломает старые эталоны и ответы (они перестанут валидироваться и совпадать)&lt;br&gt;• Каталог — единая «правда» о карточке: и эталон, и ответ, и промпты LLM строятся по нему&lt;br&gt;• dispatcher каталог НЕ использует (у него своя онтология слотов)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b85450;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="c556"><mxGeometry x="10" y="520" width="860" height="170" as="geometry"/></mxCell><mxCell id="c562" value="описывает структуру" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c556" target="c533"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1460" y="815"/></Array></mxGeometry></mxCell><mxCell id="c563" value="&lt;b&gt;Итого, одной фразой&lt;/b&gt;&lt;br&gt;Билет = текст ситуации + настройки доступа. Эталонная карточка = «правильно заполненная форма 112» (тип, теги, службы, ФИО, номера). Обучающийся заполняет такую же карточку в попытке, submit считает процент совпадений. Какие типы/теги/службы вообще бывают — определяет YAML-каталог в artifacts/etc/traineebox/catalog." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="1080" width="1420" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p852" name="12. Интеграция: целевая архитектура"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c564" value="&lt;b style='font-size:22px'&gt;ПРОЕКТ · Интеграция dispatcher ↔ ticketgen ↔ traineebox — целевая архитектура&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;Толстая пунктирная рамка = новое или изменённое. Принцип: traineebox — владелец данных (Postgres), ticketgen — генерирует, dispatcher — только исполняет звонок (читает банк из БД, сценарий получает снимком).&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="60" as="geometry"/></mxCell><mxCell id="c565" value="&lt;b&gt;Обучающийся&lt;/b&gt;&lt;br&gt;браузер + софтфон (SIP-аккаунт привязан к user)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="230" height="80" as="geometry"/></mxCell><mxCell id="c566" value="&lt;b&gt;Преподаватель&lt;/b&gt;&lt;br&gt;генерирует и правит билет (карточка + сценарий заявителя), модерирует формулировки" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="230" height="100" as="geometry"/></mxCell><mxCell id="c567" value="&lt;b&gt;Софтфон&lt;/b&gt;&lt;br&gt;PJSIP endpoint пользователя" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="560" width="230" height="70" as="geometry"/></mxCell><mxCell id="c568" value="traineebox (Go) — владелец данных" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="620" height="560" as="geometry"/></mxCell><mxCell id="c569" value="auth · groups · tickets(+attempts) · generation — как сейчас" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=11;" vertex="1" parent="c568"><mxGeometry x="10" y="30" width="600" height="30" as="geometry"/></mxCell><mxCell id="c570" value="&lt;b&gt;dialog&lt;/b&gt; (новый контекст)&lt;br&gt;слоты онтологии, формулировки (модерация), версия банка&lt;br&gt;API: /dialog/slots, /dialog/slots/{id}/questions, /dialog/bank/version" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;strokeWidth=3;dashed=1;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c568"><mxGeometry x="10" y="70" width="600" height="80" as="geometry"/></mxCell><mxCell id="c571" value="&lt;b&gt;tickets.scenario&lt;/b&gt; (новое)&lt;br&gt;ticket_scenarios: JSONB-сценарий заявителя в каноническом формате dispatcher, версия&lt;br&gt;GET/PUT /tickets/{id}/scenario (только owner/teacher)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;strokeWidth=3;dashed=1;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c568"><mxGeometry x="10" y="160" width="600" height="80" as="geometry"/></mxCell><mxCell id="c572" value="&lt;b&gt;calls&lt;/b&gt; (новый контекст)&lt;br&gt;голосовая попытка: POST /attempts/{id}/call · attempt_calls · call_turns&lt;br&gt;SIP-аккаунты пользователей (user_sip_endpoints)&lt;br&gt;/internal/calls/{id}/events, /internal/calls/{id}/turns (сервисный токен)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;strokeWidth=3;dashed=1;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c568"><mxGeometry x="10" y="250" width="600" height="100" as="geometry"/></mxCell><mxCell id="c573" value="&lt;b&gt;generation&lt;/b&gt;: draft_scenario в job, PATCH правит и карточку, и сценарий; approve публикует билет + эталон + сценарий одной транзакцией" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;strokeWidth=3;dashed=1;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c568"><mxGeometry x="10" y="360" width="600" height="60" as="geometry"/></mxCell><mxCell id="c574" value="&lt;b&gt;initializer&lt;/b&gt;: import-ontology (slots.yaml + questions из 97 сценариев) · import-scenarios (легаси-сценарии → билеты группы «Корпус»)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;strokeWidth=3;dashed=1;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c568"><mxGeometry x="10" y="430" width="600" height="60" as="geometry"/></mxCell><mxCell id="c575" value="HTTP :8080 · Postgres pool" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=11;" vertex="1" parent="c568"><mxGeometry x="10" y="500" width="600" height="40" as="geometry"/></mxCell><mxCell id="c576" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;+ dialog_slots, slot_fallbacks, slot_questions, bank_versions&lt;br&gt;+ ticket_scenarios, job.draft_scenario&lt;br&gt;+ user_sip_endpoints, attempt_calls, call_turns&lt;br&gt;NOTIFY bank_changed" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1030" y="250" width="300" height="160" as="geometry"/></mxCell><mxCell id="c577" value="&lt;b&gt;ticketgen&lt;/b&gt; (Python)&lt;br&gt;+ этап &lt;b&gt;building_dialog&lt;/b&gt;: факты по слотам из БД&lt;br&gt;ПДн (ФИО, телефоны, адрес) — одни и те же для карточки и сценария&lt;br&gt;+ опц. этап &lt;b&gt;checking_dialog&lt;/b&gt; (lint через dispatcher)&lt;br&gt;+ кандидаты формулировок для бедных слотов → pending" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;strokeWidth=3;dashed=1;" vertex="1" parent="1"><mxGeometry x="1030" y="90" width="340" height="130" as="geometry"/></mxCell><mxCell id="c578" value="&lt;b&gt;llama-server&lt;/b&gt; :8081&lt;br&gt;Qwen" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1450" y="110" width="180" height="70" as="geometry"/></mxCell><mxCell id="c579" value="&lt;b&gt;orchestrator&lt;/b&gt; (Go) :8090 (перенос с :8080)&lt;br&gt;POST /calls {call_id, attempt_id, to, scenario}&lt;br&gt;жизненный цикл звонка через ARI events (WebSocket)&lt;br&gt;шлёт события в traineebox" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;strokeWidth=3;dashed=1;" vertex="1" parent="1"><mxGeometry x="330" y="720" width="400" height="110" as="geometry"/></mxCell><mxCell id="c580" value="&lt;b&gt;Asterisk&lt;/b&gt;&lt;br&gt;dialplan: AudioSocket(${call_id}, 127.0.0.1:9001)&lt;br&gt;PJSIP: этап 1 — статичный шаблон, этап 5 — realtime из Postgres" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;strokeWidth=3;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="720" width="260" height="110" as="geometry"/></mxCell><mxCell id="c581" value="&lt;b&gt;dispatcher python&lt;/b&gt;&lt;br&gt;/sessions/open {session_id, scenario: JSON-снимок}&lt;br&gt;AudioSocket: маршрут по UUID-фрейму = call_id&lt;br&gt;банк: из БД (ontology + questions) при старте + hot reload по NOTIFY&lt;br&gt;lock на сессию вместо глобального&lt;br&gt;close → итог звонка (turns, revealed, critical) в orchestrator&lt;br&gt;POST /scenarios/lint (для ticketgen)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;strokeWidth=3;dashed=1;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="800" y="700" width="460" height="150" as="geometry"/></mxCell><mxCell id="c582" value="&lt;b&gt;Модели&lt;/b&gt;: e5-tuned, laya, GigaAM, Silero" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1330" y="740" width="260" height="60" as="geometry"/></mxCell><mxCell id="c583" value="&lt;b&gt;data/*.json, slots.yaml&lt;/b&gt;&lt;br&gt;после миграции — только источник импорта и тестовые фикстуры (bench, pytest)" style="shape=document;whiteSpace=wrap;html=1;size=0.12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1330" y="830" width="260" height="80" as="geometry"/></mxCell><mxCell id="c584" value="старт попытки (voice),&lt;br&gt;карточка, submit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c565" target="c568"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c585" value="генерация, правка,&lt;br&gt;модерация фраз" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c566" target="c568"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c586" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c568" target="c576"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c587" value="claim/CAS jobs,&lt;br&gt;читает слоты" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c577" target="c576"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c588" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c577" target="c578"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c589" value="POST /scenarios/lint" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c577" target="c581"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="660"/></Array></mxGeometry></mxCell><mxCell id="c590" value="POST /calls&lt;br&gt;(сценарий-снимок)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c568" target="c579"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="690"/></Array></mxGeometry></mxCell><mxCell id="c591" value="события звонка, turns&lt;br&gt;/internal/calls/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c579" target="c568"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="690"/></Array></mxGeometry></mxCell><mxCell id="c592" value="ARI originate + events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c579" target="c580"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c593" value="/sessions/open, close" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c579" target="c581"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c594" value="AudioSocket (UUID=call_id)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c580" target="c581"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="880"/><mxPoint x="1030" y="880"/></Array></mxGeometry></mxCell><mxCell id="c595" value="SIP/RTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="c567" target="c580"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c596" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c565" target="c567"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c597" value="SELECT банк (ro-роль),&lt;br&gt;LISTEN bank_changed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c581" target="c576"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c598" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c581" target="c582"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c599" value="ensemble / improv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;label