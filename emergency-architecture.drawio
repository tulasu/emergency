=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;rounded=0;" edge="1" parent="1" source="c162" target="c99"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c196" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;rounded=0;" edge="1" parent="1" source="c163" target="c85"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c197" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;" edge="1" parent="1" source="c172" target="c109"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c198" value="&lt;b&gt;YAML-каталог&lt;/b&gt; (не в БД)&lt;br&gt;types/*.yaml · common_tags.yaml&lt;br&gt;services.yaml · routing.yaml" style="shape=document;whiteSpace=wrap;html=1;size=0.15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1800" y="400" width="240" height="90" as="geometry"/></mxCell><mxCell id="c199" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;strokeColor=#d6b656;" edge="1" parent="1" source="c120" target="c198"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c200" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;strokeColor=#d6b656;" edge="1" parent="1" source="c127" target="c198"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c201" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;strokeColor=#d6b656;" edge="1" parent="1" source="c130" target="c198"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c202" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;strokeColor=#d6b656;" edge="1" parent="1" source="c145" target="c198"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c203" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;strokeColor=#d6b656;" edge="1" parent="1" source="c154" target="c198"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c204" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;strokeColor=#d6b656;" edge="1" parent="1" source="c157" target="c198"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c205" value="draft_reference.* коды" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;strokeColor=#d6b656;" edge="1" parent="1" source="c160" target="c198"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="630" y="1030"/><mxPoint x="1920" y="1030"/></Array></mxGeometry></mxCell><mxCell id="c206" value="&lt;b&gt;draft_reference JSONB&lt;/b&gt;&lt;br&gt;{&lt;br&gt;&amp;nbsp;incident_type_code: str,&lt;br&gt;&amp;nbsp;tag_codes: [str],&lt;br&gt;&amp;nbsp;service_codes: [str],&lt;br&gt;&amp;nbsp;applicant_last_name, applicant_first_name,&lt;br&gt;&amp;nbsp;caller_number, dictated_number&lt;br&gt;}" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1800" y="540" width="280" height="170" as="geometry"/></mxCell><mxCell id="c207" value="&lt;b&gt;История миграций&lt;/b&gt;&lt;br&gt;00001 users, sessions (+pgcrypto)&lt;br&gt;00002 groups, group_members&lt;br&gt;00003 справочники (incident_types/tags, emergency_services), tickets, эталоны, попытки, ответы&lt;br&gt;00004 incident_tag_groups (single/multi, parent_tag_id) — теги пересеяны&lt;br&gt;00005 справочники удалены → ответы хранят коды TEXT, данные ответов очищены&lt;br&gt;00006 ticket_generation_jobs&lt;br&gt;00007 расширенные статусы пайплайна (picking_type, tagging_*, building_services)" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="380" height="230" as="geometry"/></mxCell><mxCell id="c208" value="&lt;b&gt;Кто что пишет&lt;/b&gt;&lt;br&gt;traineebox: всё (sqlc-запросы на контекст auth/groups/tickets/generation)&lt;br&gt;ticketgen: только ticket_generation_jobs (claim + CAS по status+version)&lt;br&gt;dispatcher: в БД не ходит" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1800" y="740" width="280" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p844" name="4. traineebox: компоненты и API"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c209" value="&lt;b style='font-size:22px'&gt;traineebox — модульный монолит (DDD: presentation → application → domain ← infrastructure)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;Go, chi + huma v2 (OpenAPI генерится автоматически), pgx/v5 + sqlc (код генерится по internal/*/infrastructure/sql), goose-миграции, golangci. Аутентификация: Authorization: Bearer &amp;lt;session token&amp;gt; (хеш в sessions).&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="60" as="geometry"/></mxCell><mxCell id="c210" value="auth" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="520" height="440" as="geometry"/></mxCell><mxCell id="c211" value="&lt;b&gt;presentation&lt;/b&gt; (huma handlers, DTO)&lt;br&gt;health, create-user, login, logout, me, block-user, change-role" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c210"><mxGeometry x="10" y="30" width="500" height="80" as="geometry"/></mxCell><mxCell id="c212" value="&lt;b&gt;application&lt;/b&gt; (use cases)&lt;br&gt;CreateUser · Login (SessionTTL) · Logout · Me · Authenticate · BlockUser · ChangeRole&lt;br&gt;PasswordHasher · session_token (случайный токен → хеш)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c210"><mxGeometry x="10" y="120" width="500" height="100" as="geometry"/></mxCell><mxCell id="c213" value="&lt;b&gt;domain&lt;/b&gt; (models, value_objects, abilities, errs, repositories-интерфейсы)&lt;br&gt;User(id, login, password_hash, role, blocked_at) · Session&lt;br&gt;VO: Login, PasswordHash, Role{admin,teacher,student}" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c210"><mxGeometry x="10" y="230" width="500" height="100" as="geometry"/></mxCell><mxCell id="c214" value="&lt;b&gt;infrastructure&lt;/b&gt;&lt;br&gt;UserRepository, SessionRepository (authsql, sqlc)&lt;br&gt;таблицы: users, sessions" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c210"><mxGeometry x="10" y="340" width="500" height="90" as="geometry"/></mxCell><mxCell id="c215" value="groups" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="560" y="90" width="520" height="440" as="geometry"/></mxCell><mxCell id="c216" value="&lt;b&gt;presentation&lt;/b&gt; (huma handlers, DTO)&lt;br&gt;create/list/get/rename/delete group, add/remove member" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c215"><mxGeometry x="10" y="30" width="500" height="80" as="geometry"/></mxCell><mxCell id="c217" value="&lt;b&gt;application&lt;/b&gt; (use cases)&lt;br&gt;CreateGroup · RenameGroup · DeleteGroup · ListGroups · GetGroup · AddMember · RemoveMember" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c215"><mxGeometry x="10" y="120" width="500" height="100" as="geometry"/></mxCell><mxCell id="c218" value="&lt;b&gt;domain&lt;/b&gt; (models, value_objects, abilities, errs, repositories-интерфейсы)&lt;br&gt;Group, члены с MemberRole{owner,teacher,student}&lt;br&gt;abilities: add_member, assign_member_role, delete_group, remove_member, rename_group&lt;br&gt;VO: GroupName, AccountRole" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c215"><mxGeometry x="10" y="230" width="500" height="100" as="geometry"/></mxCell><mxCell id="c219" value="&lt;b&gt;infrastructure&lt;/b&gt;&lt;br&gt;GroupRepository, UserDirectory (groupssql)&lt;br&gt;таблицы: groups, group_members (+ чтение users)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c215"><mxGeometry x="10" y="340" width="500" height="90" as="geometry"/></mxCell><mxCell id="c220" value="tickets (+ attempts, catalog)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1100" y="90" width="560" height="440" as="geometry"/></mxCell><mxCell id="c221" value="&lt;b&gt;presentation&lt;/b&gt; (huma handlers, DTO)&lt;br&gt;catalog: incident-types, tags, services, recommend&lt;br&gt;tickets: create/list/get, PUT reference&lt;br&gt;attempts: start, mine, get, PATCH answer, submit" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c220"><mxGeometry x="10" y="30" width="540" height="80" as="geometry"/></mxCell><mxCell id="c222" value="&lt;b&gt;application&lt;/b&gt; (use cases)&lt;br&gt;ListIncidentTypes · ListTagsByType · ListServices · RecommendServices&lt;br&gt;CreateTicket · ListTicketsByGroup · GetTicket · SetReferenceAnswer&lt;br&gt;StartAttempt · SaveAttemptAnswer · SubmitAttempt · GetMyAttempt · ListMyAttempts&lt;br&gt;scoring.Score" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c220"><mxGeometry x="10" y="120" width="540" height="100" as="geometry"/></mxCell><mxCell id="c223" value="&lt;b&gt;domain&lt;/b&gt; (models, value_objects, abilities, errs, repositories-интерфейсы)&lt;br&gt;Ticket (окно доступности, лимит попыток, длительность) · ReferenceAnswer · Attempt · Answer · TagSelection · Catalog&lt;br&gt;abilities: ManageTicket(owner/teacher) · ViewTicket · StartAttempt(student) · ViewOwnAttempt · ListGroupAttempts&lt;br&gt;VO: AttemptStatus, TicketTitle, Notes(≤1000)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c220"><mxGeometry x="10" y="230" width="540" height="100" as="geometry"/></mxCell><mxCell id="c224" value="&lt;b&gt;infrastructure&lt;/b&gt;&lt;br&gt;TicketRepository, AttemptRepository, GroupMembership (ticketssql)&lt;br&gt;&lt;b&gt;yaml_catalog.go&lt;/b&gt; — LoadCatalog(dir) в память + CatalogRepository" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c220"><mxGeometry x="10" y="340" width="540" height="90" as="geometry"/></mxCell><mxCell id="c225" value="generation" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1680" y="90" width="520" height="440" as="geometry"/></mxCell><mxCell id="c226" value="&lt;b&gt;presentation&lt;/b&gt; (huma handlers, DTO)&lt;br&gt;create/list jobs (по группе), get, PATCH draft, retry, cancel, delete, approve" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c225"><mxGeometry x="10" y="30" width="500" height="80" as="geometry"/></mxCell><mxCell id="c227" value="&lt;b&gt;application&lt;/b&gt; (use cases)&lt;br&gt;CreateJob · ListJobs · GetJob · PatchJob · RetryJob · CancelJob · DeleteJob&lt;br&gt;&lt;b&gt;ApproveJob&lt;/b&gt;: валидирует draft по каталогу → Tickets.CreateWithReference → job.MarkPublished → SaveCAS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c225"><mxGeometry x="10" y="120" width="500" height="100" as="geometry"/></mxCell><mxCell id="c228" value="&lt;b&gt;domain&lt;/b&gt; (models, value_objects, abilities, errs, repositories-интерфейсы)&lt;br&gt;Job (status, version, draft) · DraftReference&lt;br&gt;VO: JobStatus (переходы CanEditDraft/CanRetry/CanCancel/CanApprove/CanDelete)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c225"><mxGeometry x="10" y="230" width="500" height="100" as="geometry"/></mxCell><mxCell id="c229" value="&lt;b&gt;infrastructure&lt;/b&gt;&lt;br&gt;JobRepository (generationsql): SaveCAS WHERE status=$ AND version=$&lt;br&gt;таблица: ticket_generation_jobs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c225"><mxGeometry x="10" y="340" width="500" height="90" as="geometry"/></mxCell><mxCell id="c230" value="&lt;b&gt;platform&lt;/b&gt;: config.Load() (env TRAINEEBOX_*) · postgres.NewPool (pgxpool) · &lt;b&gt;cmd/app/main.go&lt;/b&gt; — ручной DI всех use cases, Register(api) каждого контекста · graceful shutdown 10s · &lt;b&gt;testkit&lt;/b&gt; (testcontainers-postgres, seed, api) для feature-тестов" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="20" y="550" width="2220" height="50" as="geometry"/></mxCell><mxCell id="c231" value="Authenticate&lt;br&gt;(адаптер session_auth.go)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c215" target="c210"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c232" value="GroupMembership&lt;br&gt;(роль в группе)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c220" target="c215"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c233" value="Tickets repo + Catalog&lt;br&gt;(approve)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c225" target="c220"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c234" value="&lt;b&gt;REST API (все, кроме /health и /auth/login, требуют Bearer session)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&#10;&lt;b&gt;System/Auth&lt;/b&gt;&lt;br&gt;&#10;GET  /health → {status, version}&lt;br&gt;&#10;POST /auth/login {login, password} → {token, user{id, login, role}}&lt;br&gt;&#10;POST /auth/logout&lt;br&gt;&#10;GET  /auth/me → user&lt;br&gt;&#10;POST /auth/users {login, password, role} (admin)&lt;br&gt;&#10;POST /auth/users/{userId}/block {blocked}&lt;br&gt;&#10;POST /auth/users/{userId}/role {role}&lt;br&gt;&lt;br&gt;&#10;&lt;b&gt;Groups&lt;/b&gt;&lt;br&gt;&#10;POST /groups {name} (только account role teacher)&lt;br&gt;&#10;GET  /groups · GET/PATCH/DELETE /groups/{groupId}&lt;br&gt;&#10;POST /groups/{groupId}/members {user_id, role: teacher|student}&lt;br&gt;&#10;DELETE /groups/{groupId}/members/{userId}&lt;br&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="630" width="560" height="360" as="geometry"/></mxCell><mxCell id="c235" value="&lt;b&gt;Catalog&lt;/b&gt;&lt;br&gt;&#10;GET /catalog/incident-types → [{code,title}]&lt;br&gt;&#10;GET /catalog/incident-types/{typeCode}/tags → [{code,title,selection_mode,parent_tag_code,sort_order,tags[]}]&lt;br&gt;&#10;GET /catalog/services → [{code,title}]&lt;br&gt;&#10;GET /catalog/recommend?type=&amp;amp;tags= → {service_codes}&lt;br&gt;&lt;br&gt;&#10;&lt;b&gt;Tickets&lt;/b&gt;&lt;br&gt;&#10;POST /groups/{groupId}/tickets {title, body, max_attempts?, available_from?, available_until?, duration_seconds?}&lt;br&gt;&#10;GET  /groups/{groupId}/tickets · GET /tickets/{ticketId}&lt;br&gt;&#10;PUT  /tickets/{ticketId}/reference {incident_type_code, tag_codes[], service_codes[], applicant_*, caller_number, dictated_number}&lt;br&gt;&lt;br&gt;&#10;&lt;b&gt;Attempts&lt;/b&gt;&lt;br&gt;&#10;POST /tickets/{ticketId}/attempts → attempt (student)&lt;br&gt;&#10;GET  /tickets/{ticketId}/attempts/mine · GET /attempts/{attemptId}&lt;br&gt;&#10;PATCH /attempts/{attemptId}/answer {incident_type_code?, tag_codes, service_codes, applicant_*, caller_number, dictated_number, notes}&lt;br&gt;&#10;POST /attempts/{attemptId}/submit → attempt со score&lt;br&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="630" width="760" height="360" as="geometry"/></mxCell><mxCell id="c236" value="&lt;b&gt;Generation&lt;/b&gt;&lt;br&gt;&#10;POST /groups/{groupId}/generation-jobs {prompt} → job (status queued)&lt;br&gt;&#10;GET  /groups/{groupId}/generation-jobs&lt;br&gt;&#10;GET  /generation-jobs/{jobId}&lt;br&gt;&#10;PATCH /generation-jobs/{jobId} {draft_title, scenario_text, draft_reference} (только ready)&lt;br&gt;&#10;POST /generation-jobs/{jobId}/retry (failed → queued)&lt;br&gt;&#10;POST /generation-jobs/{jobId}/cancel&lt;br&gt;&#10;DELETE /generation-jobs/{jobId} (кроме published)&lt;br&gt;&#10;POST /generation-jobs/{jobId}/approve → published + ticket&lt;br&gt;&lt;br&gt;&#10;&lt;b&gt;jobDTO&lt;/b&gt;: id, group_id, created_by, prompt, status, version, scenario_text, draft_title, draft_reference, error_message, attempts, published_ticket_id, created_at, updated_at&lt;br&gt;&lt;br&gt;&#10;&lt;b&gt;attemptDTO&lt;/b&gt;: id, ticket_id, user_id, attempt_no, status, started_at, deadline_at, finished_at, score, answer{…}" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1380" y="630" width="860" height="360" as="geometry"/></mxCell><mxCell id="c237" value="Жизненный цикл попытки (ticket_attempts.status)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="1020" width="1100" height="300" as="geometry"/></mxCell><mxCell id="c238" value="start&lt;br&gt;POST /attempts" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;fontColor=#ffffff;fontSize=10;" vertex="1" parent="c237"><mxGeometry x="20" y="110" width="120" height="50" as="geometry"/></mxCell><mxCell id="c239" value="&lt;b&gt;in_progress&lt;/b&gt;&lt;br&gt;deadline = now + duration_seconds" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;" vertex="1" parent="c237"><mxGeometry x="230" y="100" width="230" height="70" as="geometry"/></mxCell><mxCell id="c240" value="&lt;b&gt;submitted&lt;/b&gt;&lt;br&gt;score = Score(ref, answer)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;" vertex="1" parent="c237"><mxGeometry x="620" y="40" width="220" height="60" as="geometry"/></mxCell><mxCell id="c241" value="&lt;b&gt;timed_out&lt;/b&gt;&lt;br&gt;при обращении после deadline" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;" vertex="1" parent="c237"><mxGeometry x="620" y="170" width="220" height="60" as="geometry"/></mxCell><mxCell id="c242" value="проверки: student группы, окно available_from..until,&lt;br&gt;finished &amp;lt; max_attempts, нет другой in_progress" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c237" source="c238" target="c239"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c243" value="PATCH answer&lt;br&gt;(валидация по каталогу)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c237" source="c239" target="c239"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="345" y="60"/><mxPoint x="420" y="60"/></Array></mxGeometry></mxCell><mxCell id="c244" value="submit (нужен эталон)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c237" source="c239" target="c240"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c245" value="save/submit после deadline" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="c237" source="c239" target="c241"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c246" value="&lt;b&gt;Оценка&lt;/b&gt; (scoring/score.go): компоненты равного веса — тип (==), теги (равенство множеств), службы (равенство множеств) + каждое непустое поле эталона: фамилия, имя, номер звонящего, продиктованный номер. score = matched·100 / n, clamp [1,100]. notes не учитываются." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="c237"><mxGeometry x="870" y="40" width="220" height="220" as="geometry"/></mxCell><mxCell id="c247" value="Роли и права" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1140" y="1020" width="1100" height="300" as="geometry"/></mxCell><mxCell id="c248" value="&lt;b&gt;Account role&lt;/b&gt; (users.role): admin — всё; teacher — может создавать группы; student.&lt;br&gt;&lt;br&gt;&lt;b&gt;Member role&lt;/b&gt; (group_members.member_role): owner (создатель группы), teacher, student.&lt;br&gt;&lt;br&gt;&lt;b&gt;abilities (tickets)&lt;/b&gt;: ManageTicket — owner/teacher или admin (создание билетов, эталонов, generation jobs, approve); ViewTicket — любой участник; StartAttempt — только student группы; ViewOwnAttempt — участник; ListGroupAttempts — owner/teacher.&lt;br&gt;&lt;br&gt;&lt;b&gt;Каталог в рантайме&lt;/b&gt;: читается один раз при старте из YAML (ошибка → log.Fatal). Выбор тегов валидируется: single-группы — не больше одного тега, дочерние группы видимы только при выбранном parent_tag." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="c247"><mxGeometry x="10" y="30" width="1080" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p845" name="5. ticketgen: пайплайн и статусы"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c249" value="&lt;b style='font-size:22px'&gt;ticketgen — LLM-генерация билета (worker.py · pipeline.py · llm.py · catalog.py)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;Вход: prompt преподавателя (строка). Выход: scenario_text + draft_title + draft_reference (JSONB) в той же строке ticket_generation_jobs, status=ready. Публикует уже traineebox (approve).&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="60" as="geometry"/></mxCell><mxCell id="c250" value="worker.main(): бесконечный цикл" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="520" height="560" as="geometry"/></mxCell><mxCell id="c251" value="load_catalog(TICKETGEN_CATALOG_PATH)&lt;br&gt;Pipeline(catalog, LLMClient(backends_from_env))" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10;" vertex="1" parent="c250"><mxGeometry x="10" y="30" width="500" height="50" as="geometry"/></mxCell><mxCell id="c252" value="psycopg.connect(DSN, autocommit)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10;" vertex="1" parent="c250"><mxGeometry x="10" y="90" width="500" height="30" as="geometry"/></mxCell><mxCell id="c253" value="&lt;b&gt;claim_job&lt;/b&gt;: UPDATE … SET status='enriching', version+1, claimed_by=WORKER_ID, lease_until=now()+LEASE, attempts+1&lt;br&gt;WHERE id = (SELECT … WHERE status='queued' OR (in-progress AND lease_until &amp;lt; now())&lt;br&gt;ORDER BY created_at FOR UPDATE SKIP LOCKED LIMIT 1)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c250"><mxGeometry x="10" y="130" width="500" height="90" as="geometry"/></mxCell><mxCell id="c254" value="нет задания → sleep(POLL_SECONDS=2)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=10;" vertex="1" parent="c250"><mxGeometry x="10" y="230" width="500" height="30" as="geometry"/></mxCell><mxCell id="c255" value="&lt;b&gt;process_job&lt;/b&gt;: этапы пайплайна; после каждого — &lt;b&gt;CAS&lt;/b&gt;:&lt;br&gt;UPDATE … WHERE id=$ AND status=$expected AND version=$expected&lt;br&gt;(rowcount≠1 → «lost claim», работа брошена)&lt;br&gt;каждый save продлевает lease" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c250"><mxGeometry x="10" y="270" width="500" height="90" as="geometry"/></mxCell><mxCell id="c256" value="исключение → CAS status='failed', error_message (≤1000), claim снят; частичный draft сохраняется" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;fontSize=10;" vertex="1" parent="c250"><mxGeometry x="10" y="370" width="500" height="50" as="geometry"/></mxCell><mxCell id="c257" value="&lt;b&gt;Восстановление&lt;/b&gt;: упавший воркер → lease истёк → задание подхватит другой воркер (статус in-progress с просроченным lease). Горизонтально масштабируется числом воркеров." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="c250"><mxGeometry x="10" y="430" width="500" height="70" as="geometry"/></mxCell><mxCell id="c258" value="queued → &lt;b&gt;enriching&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="90" width="170" height="70" as="geometry"/></mxCell><mxCell id="c259" value="&lt;b&gt;generate_scenario(prompt)&lt;/b&gt;&lt;br&gt;LLM SCENARIO_SYSTEM, t=0.5, 512 ток.&lt;br&gt;→ {title, scenario} (2–5 предложений, с адресом)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="780" y="90" width="520" height="70" as="geometry"/></mxCell><mxCell id="c260" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;" edge="1" parent="1" source="c258" target="c259"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c261" value="→ &lt;b&gt;filling_pii&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="180" width="170" height="70" as="geometry"/></mxCell><mxCell id="c262" value="&lt;b&gt;fill_pii()&lt;/b&gt; — Faker ru_RU, без LLM&lt;br&gt;last_name, first_name, caller_number 79…, dictated_number 79…, address&lt;br&gt;адрес дописывается в сценарий, если его там нет" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="780" y="180" width="520" height="70" as="geometry"/></mxCell><mxCell id="c263" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;" edge="1" parent="1" source="c261" target="c262"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c264" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c258" target="c261"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c265" value="→ &lt;b&gt;picking_type&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="270" width="170" height="70" as="geometry"/></mxCell><mxCell id="c266" value="&lt;b&gt;pick_type(scenario, prompt)&lt;/b&gt;&lt;br&gt;LLM TYPE_SYSTEM, t=0.1 → {incident_type_code}&lt;br&gt;resolve_type_code (нечёткое сопоставление) + keyword-override по prompt" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="780" y="270" width="520" height="70" as="geometry"/></mxCell><mxCell id="c267" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;" edge="1" parent="1" source="c265" target="c266"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c268" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c261" target="c265"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c269" value="→ &lt;b&gt;tagging_type&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="360" width="170" height="70" as="geometry"/></mxCell><mxCell id="c270" value="&lt;b&gt;fill_type_tags(scenario, type)&lt;/b&gt;&lt;br&gt;по каждой видимой группе типа (с учётом parent_tag):&lt;br&gt;LLM GROUP_TAG_SYSTEM → {tag_codes}; single = ровно один; repair_tags" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="780" y="360" width="520" height="70" as="geometry"/></mxCell><mxCell id="c271" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;" edge="1" parent="1" source="c269" target="c270"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c272" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c265" target="c269"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c273" value="→ &lt;b&gt;tagging_common&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="450" width="170" height="70" as="geometry"/></mxCell><mxCell id="c274" value="&lt;b&gt;fill_common_tags(scenario, type)&lt;/b&gt;&lt;br&gt;общие группы include_common (access, evacuation, medical_help, offense, threat_people, victims)&lt;br&gt;LLM COMMON_TAGS_SYSTEM → {tag_codes}" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="780" y="450" width="520" height="70" as="geometry"/></mxCell><mxCell id="c275" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;" edge="1" parent="1" source="c273" target="c274"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c276" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c269" target="c273"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c277" value="→ &lt;b&gt;building_services&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="540" width="170" height="70" as="geometry"/></mxCell><mxCell id="c278" value="&lt;b&gt;pick_services(scenario, type, tags)&lt;/b&gt;&lt;br&gt;catalog.recommend_services: routing.yaml always + when(tags_any → add)&lt;br&gt;LLM SERVICES_SYSTEM может добавить; merge, только коды из каталога" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="780" y="540" width="520" height="70" as="geometry"/></mxCell><mxCell id="c279" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;htm