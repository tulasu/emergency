om;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945.0" y="502" as="sourcePoint"/><mxPoint x="1755.0" y="502" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c763" value="load_scenario(dict) → Cascade (банк из БД) → Session; {opening}" style="text;html=1;fontSize=10;align=left;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1763.0" y="532" width="310" height="32" as="geometry"/></mxCell><mxCell id="c764" value="ARI POST /channels endpoint=PJSIP/{endpoint}, vars call_id" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945.0" y="594" as="sourcePoint"/><mxPoint x="1215.0" y="594" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c765" value="event ringing → UPDATE status" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945.0" y="640" as="sourcePoint"/><mxPoint x="405.0" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c766" value="INVITE" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1215.0" y="686" as="sourcePoint"/><mxPoint x="1485.0" y="686" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c767" value="200 OK" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1485.0" y="732" as="sourcePoint"/><mxPoint x="1215.0" y="732" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c768" value="event answered (StasisStart/ChannelStateChange)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945.0" y="778" as="sourcePoint"/><mxPoint x="405.0" y="778" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c769" value="AudioSocket(${call_id}): 1-й фрейм UUID → Service.sessions[call_id]" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1215.0" y="824" as="sourcePoint"/><mxPoint x="1755.0" y="824" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c770" value="Разговор: VAD → STT → NLU → политика → TTS (как сейчас)" style="text;html=1;align=left;spacingLeft=8;fontSize=11;fontStyle=1;fillColor=#eeeeee;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="30" y="856" width="1830" height="26" as="geometry"/></mxCell><mxCell id="c771" value="параллельно заполняет карточку в браузере: PATCH /attempts/{a}/answer" style="text;html=1;fontSize=10;align=left;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="143.0" y="900" width="310" height="32" as="geometry"/></mxCell><mxCell id="c772" value="BYE (или DELETE /calls → ARI hangup)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1485.0" y="962" as="sourcePoint"/><mxPoint x="1215.0" y="962" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c773" value="hangup-фрейм" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1215.0" y="1008" as="sourcePoint"/><mxPoint x="1755.0" y="1008" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c774" value="close(): итог {turns[], revealed, critical_missed, bank_version, wav paths}" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1755.0" y="1054" as="sourcePoint"/><mxPoint x="945.0" y="1054" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c775" value="POST /internal/calls/{id}/events {completed, hangup_cause} + /turns" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945.0" y="1100" as="sourcePoint"/><mxPoint x="405.0" y="1100" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c776" value="UPDATE attempt_calls, INSERT call_turns" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405.0" y="1146" as="sourcePoint"/><mxPoint x="675.0" y="1146" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c777" value="Оценка" style="text;html=1;align=left;spacingLeft=8;fontSize=11;fontStyle=1;fillColor=#eeeeee;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="30" y="1178" width="1830" height="26" as="geometry"/></mxCell><mxCell id="c778" value="POST /attempts/{a}/submit" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="1238" as="sourcePoint"/><mxPoint x="405.0" y="1238" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c779" value="score = как сейчас (карточка vs эталон); + опц. метрика опроса: доля critical-фактов, которые оператор выяснил" style="text;html=1;fontSize=10;align=left;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="413.0" y="1268" width="310" height="32" as="geometry"/></mxCell><mxCell id="c780" value="attempt {score, calls[], (для преподавателя — стенограмма)}" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405.0" y="1330" as="sourcePoint"/><mxPoint x="135.0" y="1330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c781" value="Сбои" style="text;html=1;align=left;spacingLeft=8;fontSize=11;fontStyle=1;fillColor=#eeeeee;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="30" y="1362" width="1830" height="26" as="geometry"/></mxCell><mxCell id="c782" value="no_answer / failed / timeout originate → attempt_calls.status; попытка остаётся in_progress, можно перезвонить" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945.0" y="1422" as="sourcePoint"/><mxPoint x="405.0" y="1422" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c783" value="deadline попытки истёк во время звонка → orchestrator: DELETE канала, attempt timed_out" style="text;html=1;fontSize=10;align=left;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="413.0" y="1452" width="310" height="32" as="geometry"/></mxCell><mxCell id="c784" value="&lt;b&gt;Что видит обучающийся&lt;/b&gt;: только briefing (напр. «Вы оператор 112, примите вызов»), не body/сценарий — иначе он заранее знает ответы. После submit — стенограмма и эталон." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1950" y="150" width="560" height="110" as="geometry"/></mxCell><mxCell id="c785" value="&lt;b&gt;Альтернатива «звонит обучающийся»&lt;/b&gt;: пользователь набирает номер тренажёра, Asterisk спрашивает PIN попытки (DTMF) → orchestrator сопоставляет PIN с attempt. Проще с NAT и мобильными софтфонами, но сложнее UX. Выбрать до этапа 4." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1950" y="280" width="560" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p856" name="16. Флоу C: онтология и банк в БД"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c786" value="&lt;b style='font-size:22px'&gt;ПРОЕКТ · Флоу C — слоты и формулировки в Postgres: импорт, правка, перезагрузка банка, дообучение&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;Банк (LexicalBank + VectorBank) по-прежнему собирается в памяти процесса dispatcher — БД только источник. Горячий путь звонка к БД не ходит.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="60" as="geometry"/></mxCell><mxCell id="c787" value="initializer / админ" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="240" height="1014" as="geometry"/></mxCell><mxCell id="c788" value="traineebox API" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="240" height="1014" as="geometry"/></mxCell><mxCell id="c789" value="Postgres" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="90" width="240" height="1014" as="geometry"/></mxCell><mxCell id="c790" value="dispatcher python" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="90" width="240" height="1014" as="geometry"/></mxCell><mxCell id="c791" value="offline: train_encoder" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1230" y="90" width="240" height="1014" as="geometry"/></mxCell><mxCell id="c792" value="Однократный импорт (этап 1)" style="text;html=1;align=left;spacingLeft=8;fontSize=11;fontStyle=1;fillColor=#eeeeee;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="30" y="166" width="1440" height="26" as="geometry"/></mxCell><mxCell id="c793" value="import-ontology: slots.yaml → dialog_slots, slot_fallbacks, slot_aliases, questions (source=ontology)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150.0" y="226" as="sourcePoint"/><mxPoint x="750.0" y="226" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c794" value="questions из 97 сценариев → slot_questions (source=legacy, source_ref=scenario id, approved)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150.0" y="272" as="sourcePoint"/><mxPoint x="750.0" y="272" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c795" value="проверка паритета: digest банка из БД == data/build/bank.json; bench.run даёт те же цифры" style="text;html=1;fontSize=10;align=left;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="158.0" y="302" width="340" height="32" as="geometry"/></mxCell><mxCell id="c796" value="Старт dispatcher" style="text;html=1;align=left;spacingLeft=8;fontSize=11;fontStyle=1;fillColor=#eeeeee;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="30" y="350" width="1440" height="26" as="geometry"/></mxCell><mxCell id="c797" value="SELECT slots, fallbacks, approved questions (+source_ref)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050.0" y="410" as="sourcePoint"/><mxPoint x="750.0" y="410" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c798" value="Ontology + LexicalBank.build + VectorBank.build (эмбеддинги: GPU секунды, CPU ~минута) · кэш на диск по digest" style="text;html=1;fontSize=10;align=left;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1058.0" y="440" width="340" height="32" as="geometry"/></mxCell><mxCell id="c799" value="LISTEN bank_changed" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050.0" y="502" as="sourcePoint"/><mxPoint x="750.0" y="502" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c800" value="Правка в рантайме" style="text;html=1;align=left;spacingLeft=8;fontSize=11;fontStyle=1;fillColor=#eeeeee;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="30" y="534" width="1440" height="26" as="geometry"/></mxCell><mxCell id="c801" value="POST /dialog/slots/{id}/questions · PATCH status · POST /dialog/slots" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="594" as="sourcePoint"/><mxPoint x="750.0" y="594" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c802" value="NOTIFY bank_changed {version}" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750.0" y="640" as="sourcePoint"/><mxPoint x="1050.0" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c803" value="фон: пересобрать банк → атомарно подменить ссылку; идущие звонки дочитывают старый банк (он неизменяем)" style="text;html=1;fontSize=10;align=left;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1058.0" y="670" width="340" height="32" as="geometry"/></mxCell><mxCell id="c804" value="Источники новых формулировок" style="text;html=1;align=left;spacingLeft=8;fontSize=11;fontStyle=1;fillColor=#eeeeee;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="30" y="718" width="1440" height="26" as="geometry"/></mxCell><mxCell id="c805" value="реплики живых звонков с низкой уверенностью / dont_know → call_turns" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050.0" y="778" as="sourcePoint"/><mxPoint x="450.0" y="778" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c806" value="преподаватель размечает слот → slot_questions (source=live, pending → approved)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="824" as="sourcePoint"/><mxPoint x="750.0" y="824" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c807" value="Дообучение (периодически)" style="text;html=1;align=left;spacingLeft=8;fontSize=11;fontStyle=1;fillColor=#eeeeee;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="30" y="856" width="1440" height="26" as="geometry"/></mxCell><mxCell id="c808" value="выгрузка approved-формулировок (source_ref для свёрток по сценариям)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1350.0" y="916" as="sourcePoint"/><mxPoint x="750.0" y="916" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c809" value="train_encoder → models/e5-small-tuned-&amp;lt;дата&amp;gt;; bench.run на слепых наборах; пороги пересчитать" style="text;html=1;fontSize=10;align=left;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="1358.0" y="946" width="340" height="32" as="geometry"/></mxCell><mxCell id="c810" value="выкатка весов = рестарт воркеров (энкодер не меняется на лету)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1350.0" y="1008" as="sourcePoint"/><mxPoint x="1050.0" y="1008" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c811" value="&lt;b&gt;Предупреждения из README, которые переходят на БД&lt;/b&gt;&lt;br&gt;• дообучение заучивает ошибки разметки → модерация формулировок обязательна&lt;br&gt;• пороги калибруются по слепым наборам, не по банку — после крупных изменений банка прогонять bench.run&lt;br&gt;• дообученный энкодер + лексические пороги смешивать нельзя (пресеты Thresholds)" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1560" y="150" width="560" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p857" name="17. План перехода"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c812" value="&lt;b style='font-size:22px'&gt;ПРОЕКТ · План перехода по этапам (каждый этап выкатывается отдельно и ничего не ломает)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;Порядок выбран так, чтобы сначала убрать блокеры звонков, потом перенести данные с проверкой паритета, и только потом связывать продукты.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="60" as="geometry"/></mxCell><mxCell id="c813" value="Этап 0 · Подготовка dispatcher" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="410" height="560" as="geometry"/></mxCell><mxCell id="c814" value="• AudioSocket: AudioSocket(${call_id}) в dialplan, маршрут по UUID-фрейму вместо «последней сессии»&lt;br&gt;• lock на сессию вместо глобального LOCK в serve.py&lt;br&gt;• /sessions/open принимает inline scenario (load_scenario из dict)&lt;br&gt;• проверка slot ∈ онтология в loader&lt;br&gt;• orchestrator → :8090, ARI events (WebSocket), hangup через ARI&lt;br&gt;• итог звонка из close() наружу" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="c813"><mxGeometry x="10" y="30" width="390" height="400" as="geometry"/></mxCell><mxCell id="c815" value="&lt;b&gt;Готово, когда:&lt;/b&gt;&lt;br&gt;2 параллельных звонка на разные сценарии не путаются; тесты test_session/test_serve зелёные" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c813"><mxGeometry x="10" y="440" width="390" height="110" as="geometry"/></mxCell><mxCell id="c816" value="Этап 1 · Онтология и банк в Postgres" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="450" y="100" width="410" height="560" as="geometry"/></mxCell><mxCell id="c817" value="• миграции: dialog_slots, slot_fallbacks, slot_aliases, slot_questions, bank_versions (+триггер, NOTIFY)&lt;br&gt;• initializer import-ontology (slots.yaml + questions 97 сценариев с source_ref)&lt;br&gt;• dispatcher: загрузка банка из БД (DSN, ro-роль), флаг --bank db|files&lt;br&gt;• traineebox: контекст dialog (чтение + CRUD для admin/teacher)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="c816"><mxGeometry x="10" y="30" width="390" height="400" as="geometry"/></mxCell><mxCell id="c818" value="&lt;b&gt;Готово, когда:&lt;/b&gt;&lt;br&gt;digest банка из БД = bank.json; bench.run / bench.loo — те же цифры" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c816"><mxGeometry x="10" y="440" width="390" height="110" as="geometry"/></mxCell><mxCell id="c819" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c813" target="c816"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c820" value="Этап 2 · Сценарий в билете" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="880" y="100" width="410" height="560" as="geometry"/></mxCell><mxCell id="c821" value="• ticket_scenarios (JSONB), tickets.mode, tickets.briefing&lt;br&gt;• GET/PUT /tickets/{id}/scenario + Go-валидатор (общий JSON Schema для Go и Python)&lt;br&gt;• студент не видит сценарий/body в voice-режиме&lt;br&gt;• initializer import-scenarios: 97 сценариев → билеты группы «Корпус»" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="c820"><mxGeometry x="10" y="30" width="390" height="400" as="geometry"/></mxCell><mxCell id="c822" value="&lt;b&gt;Готово, когда:&lt;/b&gt;&lt;br&gt;легаси-сценарий из БД в cli chat даёт тот же replay, что из файла" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c820"><mxGeometry x="10" y="440" width="390" height="110" as="geometry"/></mxCell><mxCell id="c823" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c816" target="c820"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c824" value="Этап 3 · ticketgen генерирует сценарий" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1310" y="100" width="410" height="560" as="geometry"/></mxCell><mxCell id="c825" value="• draft_scenario, dialog_report в jobs; статусы building_dialog, checking_dialog&lt;br&gt;• этап building_dialog (ПДн → факты детерминированно, остальное LLM)&lt;br&gt;• POST /scenarios/lint в dispatcher, кандидаты формулировок → pending&lt;br&gt;• PATCH/approve: сценарий + карточка в одной транзакции (заодно чинит неатомарный approve)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="c824"><mxGeometry x="10" y="30" width="390" height="400" as="geometry"/></mxCell><mxCell id="c826" value="&lt;b&gt;Готово, когда:&lt;/b&gt;&lt;br&gt;10 сгенерированных билетов: lint без недостижимых critical-фактов, ПДн сценария ≡ карточке" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c824"><mxGeometry x="10" y="440" width="390" height="110" as="geometry"/></mxCell><mxCell id="c827" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c820" target="c824"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c828" value="Этап 4 · Голосовая попытка" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1740" y="100" width="410" height="560" as="geometry"/></mxCell><mxCell id="c829" value="• user_sip_endpoints (статичный pjsip-шаблон + таблица соответствия)&lt;br&gt;• attempts.mode, POST /attempts/{id}/call, attempt_calls, call_turns&lt;br&gt;• /internal/calls/* с сервисным токеном; orchestrator шлёт события&lt;br&gt;• дедлайн попытки рвёт звонок; повторный звонок в той же попытке" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="c828"><mxGeometry x="10" y="30" width="390" height="400" as="geometry"/></mxCell><mxCell id="c830" value="&lt;b&gt;Готово, когда:&lt;/b&gt;&lt;br&gt;e2e: старт попытки → звонок на софтфон → разговор → submit → стенограмма в попытке" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c828"><mxGeometry x="10" y="440" width="390" height="110" as="geometry"/></mxCell><mxCell id="c831" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c824" target="c828"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c832" value="Этап 5 · Эксплуатация" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="2170" y="100" width="410" height="560" as="geometry"/></mxCell><mxCell id="c833" value="• Asterisk PJSIP realtime из Postgres (ps_endpoints/ps_auths/ps_aors) — выдача SIP-аккаунтов из traineebox&lt;br&gt;• hot reload банка по NOTIFY; кэш эмбеддингов по digest&lt;br&gt;• предрендер аудио для опубликованных билетов (фоновая задача) вместо живого Silero&lt;br&gt;• разметка живых реплик → формулировки → периодическое дообучение&lt;br&gt;• метрика опроса (critical coverage) в оценке; Caddy как reverse proxy" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="c832"><mxGeometry x="10" y="30" width="390" height="400" as="geometry"/></mxCell><mxCell id="c834" value="&lt;b&gt;Готово, когда:&lt;/b&gt;&lt;br&gt;нагрузочный тест: N звонков на GPU при p95 VAD→аудио &lt; 800 мс" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="c832"><mxGeometry x="10" y="440" width="390" height="110" as="geometry"/></mxCell><mxCell id="c835" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c828" target="c832"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c836" value="Этапы 0 и 1 независимы и могут идти параллельно · 2 зависит от 1 (валидация слотов) · 3 от 2 · 4 от 0 и 2 · 5 — после 4" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="2560" height="36" as="geometry"/></mxCell><mxCell id="c837" value="Открытые вопросы (решить до начала этапа, указанного в скобках)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="740" width="1270" height="420" as="geometry"/></mxCell><mxCell id="c838" value="1. &lt;b&gt;Кто кому звонит&lt;/b&gt; (4): система звонит на софтфон пользователя (как сейчас) или пользователь звонит на номер тренажёра с PIN попытки?&lt;br&gt;2. &lt;b&gt;Что видит обучающийся&lt;/b&gt; (2): только briefing? нужен ли текстовый режим без звонка для того же билета (mode=both)?&lt;br&gt;3. &lt;b&gt;Модерация формулировок&lt;/b&gt; (1): кто утверждает — admin, любой teacher? автоутверждение для source=legacy/ontology — да.&lt;br&gt;4. &lt;b&gt;Сценарий в оценке&lt;/b&gt; (4): учитывать ли, выяснил ли оператор critical-факты, или оценка только по карточке?&lt;br&gt;5. &lt;b&gt;Один SIP-аккаунт на пользователя&lt;/b&gt; или пул общих линий на класс с выбором при старте? (4)&lt;br&gt;6. &lt;b&gt;Правка опубликованного билета&lt;/b&gt; (2): новая версия ticket_scenarios, старые попытки ссылаются на свою версию — достаточно?&lt;br&gt;7. &lt;b&gt;Хранение записей звонков&lt;/b&gt; (4): wav на диске python-воркера (как data/calls) или объектное хранилище? срок хранения ПДн?" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="c837"><mxGeometry x="10" y="30" width="1250" height="380" as="geometry"/></mxCell><mxCell id="c839" value="Риски" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1310" y="740" width="1270" height="420" as="geometry"/></mxCell><mxCell id="c840" value="• &lt;b&gt;Качество LLM-фактов&lt;/b&gt;: Qwen 1.7–4B может выдумать ответ, противоречащий карточке → детерминированные ПДн-факты + валидатор + обязательный просмотр преподавателем перед approve.&lt;br&gt;• &lt;b&gt;Бедные слоты&lt;/b&gt;: новый слот без формулировок узнаётся в 15–18% → lint на этапе генерации и кандидаты формулировок.&lt;br&gt;• &lt;b&gt;Засорение банка&lt;/b&gt;: сгенерированные формулировки без модерации портят разрыв уверенности для всех билетов → только pending → approved.&lt;br&gt;• &lt;b&gt;Дрейф порогов&lt;/b&gt;: рост банка меняет шкалу оценок → bench.run в CI при изменении банка.&lt;br&gt;• &lt;b&gt;Дублирование логики&lt;/b&gt;: валидация сценария в Go и Python → общий JSON Schema, тесты на одних фикстурах.&lt;br&gt;• &lt;b&gt;GPU-ресурс&lt;/b&gt;: dispatcher (e5+laya+GigaAM+Silero) и llama для ticketgen на одной карте → очередь генерации не должна душить звонки (приоритеты/отдельный инстанс llama).&lt;br&gt;• &lt;b&gt;ПДн&lt;/b&gt;: Faker-данные фиктивны, но записи голоса обучающихся — реальные ПДн." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="c839"><mxGeometry x="10" y="30" width="1250" height="380" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>