<mxfile host="app.diagrams.net" type="device"><diagram id="p841" name="1. Обзор системы"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style='font-size:22px'&gt;Emergency — тренажёр оператора 112: обзор системы&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;Монорепо: traineebox (Go, REST API учебного процесса) · ticketgen (Python, LLM-генерация билетов) · dispatcher (голосовой «заявитель» по SIP) · общая инфраструктура (Postgres, Caddy, CUE-конфиг, YAML-каталог)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="60" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Преподаватель&lt;/b&gt;&lt;br&gt;&lt;i&gt;account role: teacher&lt;/i&gt;&lt;br&gt;создаёт группы, билеты, эталоны, задания на генерацию" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="220" height="90" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Обучающийся&lt;/b&gt; (оператор 112)&lt;br&gt;&lt;i&gt;account role: student&lt;/i&gt;&lt;br&gt;проходит попытки, заполняет карточку" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="220" height="90" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Администратор&lt;/b&gt;&lt;br&gt;&lt;i&gt;role: admin&lt;/i&gt;&lt;br&gt;пользователи, блокировка, роли" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="220" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Софтфон&lt;/b&gt; (MicroSIP)&lt;br&gt;PJSIP endpoint &lt;code&gt;op_test&lt;/code&gt;&lt;br&gt;кодек alaw" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="220" height="80" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Клиент / UI&lt;/b&gt;&lt;br&gt;&lt;i&gt;в репозитории нет&lt;/i&gt;&lt;br&gt;(Swagger/OpenAPI от huma, curl)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;dashed=1;" vertex="1" parent="1"><mxGeometry x="360" y="280" width="200" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;traineebox&lt;/b&gt; · Go 1.x&lt;br&gt;chi + huma v2 (OpenAPI), pgx/v5, sqlc, goose&lt;br&gt;HTTP :8080&lt;br&gt;&lt;br&gt;контексты: auth · groups · tickets(+attempts, catalog) · generation" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="230" width="320" height="150" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;traineebox initializer&lt;/b&gt; (CLI, cobra)&lt;br&gt;migrate up/down/status · seed-admin" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="110" width="320" height="60" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;БД &lt;code&gt;emergency&lt;/code&gt;&lt;br&gt;:5432" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1150" y="250" width="200" height="110" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;YAML-каталог&lt;/b&gt;&lt;br&gt;&lt;code&gt;artifacts/etc/traineebox/catalog&lt;/code&gt;&lt;br&gt;51 тип происшествия · теги (группы, parent_tag) · ~210 служб · routing (24 правила)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.15;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="680" y="470" width="320" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;ticketgen&lt;/b&gt; · Python 3.12 worker&lt;br&gt;psycopg3, Faker, urllib&lt;br&gt;опрашивает очередь ticket_generation_jobs&lt;br&gt;(FOR UPDATE SKIP LOCKED + lease)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1150" y="450" width="260" height="110" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;llama-server&lt;/b&gt; (llama.cpp, CUDA)&lt;br&gt;OpenAI-совместимый &lt;code&gt;/v1/chat/completions&lt;/code&gt;&lt;br&gt;127.0.0.1:8081&lt;br&gt;Qwen3-4B-Instruct / Qwen3-1.7B (GGUF)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1500" y="450" width="280" height="110" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Caddy 2&lt;/b&gt; :80/:443&lt;br&gt;сейчас только заглушка&lt;br&gt;«emergency edge ok»" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="110" width="200" height="80" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;orchestrator&lt;/b&gt; · Go&lt;br&gt;:8080  POST/GET/DELETE /calls&lt;br&gt;ARI originate, UDP-помпа RTP" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="760" width="280" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Asterisk 20&lt;/b&gt;&lt;br&gt;PJSIP UDP 5060, ARI :8088&lt;br&gt;dialplan trainer-in → AudioSocket" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="760" width="220" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;dispatcher python&lt;/b&gt; (serve.py)&lt;br&gt;HTTP :8000 /sessions/*, /rtp, /health&lt;br&gt;AudioSocket TCP :9001&lt;br&gt;VAD → STT → NLU-каскад → политика → TTS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1150" y="740" width="320" height="120" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Модели&lt;/b&gt; models/&lt;br&gt;e5-small-tuned (энкодер) · laya (арбитр)&lt;br&gt;GigaAM-v2 / Vosk / Whisper (STT)&lt;br&gt;Silero v4_ru (TTS)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1560" y="740" width="280" height="110" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Данные dispatcher&lt;/b&gt; data/&lt;br&gt;ontology/slots.yaml (91 слот) · scenarios/*.json (97)&lt;br&gt;blind/*.txt (105) · gold · build/bank.json&lt;br&gt;audio/ (предрендер wav) · calls/ (логи звонков)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1150" y="930" width="320" height="110" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;just call&lt;/b&gt; / curl&lt;br&gt;запуск звонка по сценарию" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="930" width="280" height="50" as="geometry"/></mxCell><mxCell id="c20" value="REST: группы, билеты,&lt;br&gt;эталоны, generation-jobs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="155"/></Array></mxGeometry></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="HTTPS/JSON&lt;br&gt;Bearer session-token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="REST: попытки,&lt;br&gt;ответы, submit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="515"/><mxPoint x="620" y="340"/></Array></mxGeometry></mxCell><mxCell id="c24" value="миграции goose,&lt;br&gt;seed admin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="140"/></Array></mxGeometry></mxCell><mxCell id="c25" value="pgx pool&lt;br&gt;(sqlc)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="читает при старте&lt;br&gt;(в памяти)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="claim / CAS-update&lt;br&gt;jobs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="читает&lt;br&gt;(валидация, промпты)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="505"/><mxPoint x="1100" y="540"/></Array></mxGeometry></mxCell><mxCell id="c29" value="chat_json&lt;br&gt;(failover по backends)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="говорит голосом" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="SIP / RTP alaw" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="c5" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="POST /calls {to, scenario_id}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="ARI POST /channels&lt;br&gt;(originate)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="/sessions/check, open, close&lt;br&gt;/rtp (эхо-помпа v1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c14" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="AudioSocket TCP :9001&lt;br&gt;SLIN 8 кГц" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="890"/><mxPoint x="1100" y="890"/><mxPoint x="1100" y="820"/></Array></mxGeometry></mxCell><mxCell id="c36" value="ensemble-голос&lt;br&gt;+ improv (ответы вне сценария)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="интеграции в коде НЕТ:&lt;br&gt;билет traineebox ≠ сценарий dispatcher" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#b85450;fontColor=#b85450;endArrow=open;" edge="1" parent="1" source="c7" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="690"/><mxPoint x="1310" y="690"/></Array></mxGeometry></mxCell><mxCell id="c40" value="Легенда" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1900" y="110" width="230" height="200" as="geometry"/></mxCell><mxCell id="c41" value="traineebox (Go)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c40"><mxGeometry x="10" y="28" width="210" height="20" as="geometry"/></mxCell><mxCell id="c42" value="ticketgen (Python)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c40"><mxGeometry x="10" y="52" width="210" height="20" as="geometry"/></mxCell><mxCell id="c43" value="dispatcher (Python/Go/Asterisk)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c40"><mxGeometry x="10" y="76" width="210" height="20" as="geometry"/></mxCell><mxCell id="c44" value="инфраструктура" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c40"><mxGeometry x="10" y="100" width="210" height="20" as="geometry"/></mxCell><mxCell id="c45" value="LLM / ML-модели" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c40"><mxGeometry x="10" y="124" width="210" height="20" as="geometry"/></mxCell><mxCell id="c46" value="файлы / данные" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c40"><mxGeometry x="10" y="148" width="210" height="20" as="geometry"/></mxCell><mxCell id="c47" value="люди / внешнее" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c40"><mxGeometry x="10" y="172" width="210" height="20" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Идея продукта&lt;/b&gt;&lt;br&gt;1. Преподаватель описывает происшествие → ticketgen (LLM) генерирует билет: сценарий + эталонная карточка (тип, теги, службы, ФИО, номера).&lt;br&gt;2. Преподаватель правит и публикует → tickets + reference answer.&lt;br&gt;3. Обучающийся проходит попытку: заполняет карточку, submit → авто-оценка 1..100.&lt;br&gt;4. Голосовой контур: dispatcher звонит обучающемуся на софтфон и играет заявителя по сценарию (ответы — только факты из сценария)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1900" y="340" width="280" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p842" name="2. Контейнеры и деплой"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c49" value="&lt;b style='font-size:22px'&gt;Контейнеры, порты, тома, конфигурация&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;Два compose-стека + процессы на хосте. Корневой compose генерируется: config/system.cue + config/dev.cue → cue export → docker-compose.yml (just generate). Оркестрация — justfile.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="60" as="geometry"/></mxCell><mxCell id="c50" value="Корневой стек · docker-compose.yml (из CUE) · bridge-сеть" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="900" height="560" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;postgres&lt;/b&gt;&lt;br&gt;image: postgres:16&lt;br&gt;ports: 5432:5432&lt;br&gt;env: POSTGRES_USER/PASSWORD/DB = emergency&lt;br&gt;volume: postgres_data → /var/lib/postgresql/data&lt;br&gt;restart: unless-stopped" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="c50"><mxGeometry x="20" y="50" width="270" height="140" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;caddy&lt;/b&gt;&lt;br&gt;image: caddy:2&lt;br&gt;ports: 80, 443 (tls internal)&lt;br&gt;Caddyfile ← artifacts/etc/caddy/Caddyfile:ro&lt;br&gt;volumes: caddy_data, caddy_config&lt;br&gt;respond «emergency edge ok» (прокси пока нет)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="c50"><mxGeometry x="310" y="50" width="290" height="140" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;ticketgen&lt;/b&gt;&lt;br&gt;build: ticketgen/Dockerfile (python:3.12-slim)&lt;br&gt;CMD python worker.py&lt;br&gt;depends_on: postgres&lt;br&gt;volume: artifacts/etc/traineebox/catalog → /catalog:ro&lt;br&gt;env:&lt;br&gt;&amp;nbsp;TICKETGEN_POSTGRES_DSN=postgres://…@postgres:5432/emergency&lt;br&gt;&amp;nbsp;TICKETGEN_CATALOG_PATH=/catalog&lt;br&gt;&amp;nbsp;TICKETGEN_LLM_BACKENDS=[{name,url,model,priority,timeout}]&lt;br&gt;&amp;nbsp;TICKETGEN_POLL_SECONDS=2 · TICKETGEN_LEASE_SECONDS=120&lt;br&gt;&amp;nbsp;(+ TICKETGEN_WORKER_ID, TICKETGEN_MAX_JOB_ATTEMPTS)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="c50"><mxGeometry x="20" y="210" width="580" height="200" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;CUE-конфиг&lt;/b&gt;&lt;br&gt;system.cue: схема #Config (postgres, ticketgen.llm.backends, poll/lease)&lt;br&gt;dev.cue: значения (root=./artifacts, backend qwen3-1.7b @ http://host.docker.internal:8081)&lt;br&gt;→ генерирует env и пути томов" style="shape=document;whiteSpace=wrap;html=1;size=0.1;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c50"><mxGeometry x="620" y="50" width="260" height="180" as="geometry"/></mxCell><mxCell id="c55" value="⚠ Закоммиченный docker-compose.yml устарел: в нём только postgres+caddy, сервиса ticketgen нет. Нужен &lt;code&gt;just generate&lt;/code&gt;." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#b85450;" vertex="1" parent="c50"><mxGeometry x="620" y="250" width="260" height="90" as="geometry"/></mxCell><mxCell id="c56" value="⚠ ticketgen ходит в LLM по host.docker.internal:8081, а llama слушает 127.0.0.1:8081 (host network) и на Linux нужен extra_hosts: host-gateway — из bridge-контейнера не достучится." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#b85450;" vertex="1" parent="c50"><mxGeometry x="20" y="430" width="580" height="70" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;named volumes&lt;/b&gt;: postgres_data · caddy_data · caddy_config" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;" vertex="1" parent="c50"><mxGeometry x="620" y="360" width="260" height="50" as="geometry"/></mxCell><mxCell id="c58" value="Стек dispatcher · dispatcher/docker-compose.yml · network_mode: host у всех · env из dispatcher/.env" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="960" y="90" width="1300" height="760" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;asterisk&lt;/b&gt;&lt;br&gt;image: andrius/asterisk:20&lt;br&gt;SIP UDP 0.0.0.0:5060 (PJSIP)&lt;br&gt;ARI HTTP 127.0.0.1:8088&lt;br&gt;RTP (порты asterisk)&lt;br&gt;конфиги (ro): pjsip.conf, extensions.conf, http.conf, ari.conf&lt;br&gt;replicas: 1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="c58"><mxGeometry x="20" y="40" width="300" height="160" as="geometry"/></mxCell><mxCell id="c60" value="&lt;b&gt;orchestrator&lt;/b&gt; (Go 1.22, alpine)&lt;br&gt;build: ./orchestrator&lt;br&gt;HTTP :8080  /calls&lt;br&gt;UDP RTP_BASE=10000 + N (по звонку)&lt;br&gt;env: ARI_URL=http://127.0.0.1:8088/ari, ARI_USER/PASS,&lt;br&gt;PY_URL=http://127.0.0.1:8000&lt;br&gt;depends_on: asterisk, python" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="c58"><mxGeometry x="340" y="40" width="330" height="160" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;python&lt;/b&gt; (dispatcher)&lt;br&gt;build: Dockerfile.gpu (python:3.12-slim + torch cu130, onnxruntime, transformers, laya, vosk, espeak-ng, ffmpeg)&lt;br&gt;CMD tools/serve.sh → python -m dispatcher.serve&lt;br&gt;HTTP :8000 · AudioSocket 127.0.0.1:9001&lt;br&gt;GPU: nvidia all&lt;br&gt;env: DISPATCHER_MODEL/BACKEND/DEVICE/ARBITER/STT/ENSEMBLE/IMPROV, DISPATCHER_LLM_URL=:8081, HF_HOME, HF_HUB_OFFLINE=1, GIGAAM_MODEL_PATH&lt;br&gt;depends_on: llama" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="c58"><mxGeometry x="690" y="40" width="580" height="170" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;llama&lt;/b&gt;&lt;br&gt;image: ghcr.io/ggml-org/llama.cpp:server-cuda&lt;br&gt;127.0.0.1:8081, -ngl 99, -c 4096, -np 2&lt;br&gt;model: ${DISPATCHER_LLM:-Qwen3-4B-Instruct-2507-Q4_K_M.gguf}&lt;br&gt;volume: ./models/llama:/models:ro&lt;br&gt;healthcheck /health · GPU" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="c58"><mxGeometry x="690" y="230" width="580" height="120" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;Тома python&lt;/b&gt;&lt;br&gt;./models → /app/models:ro&lt;br&gt;~/.cache/torch/hub (Silero) :ro&lt;br&gt;data/ontology, scenarios, gold, blind :ro&lt;br&gt;data/audio (предрендер, rw)&lt;br&gt;data/calls (логи звонков, rw)" style="shape=document;whiteSpace=wrap;html=1;size=0.08;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c58"><mxGeometry x="690" y="370" width="300" height="140" as="geometry"/></mxCell><mxCell id="c64" value="&lt;b&gt;.env (дефолт — GPU)&lt;/b&gt;&lt;br&gt;DISPATCHER_MODEL=e5-small-tuned-rerun&lt;br&gt;BACKEND=torch · DEVICE=cuda&lt;br&gt;STT=gigaam · ARBITER=(пусто)&lt;br&gt;ENSEMBLE=majority · IMPROV=1&lt;br&gt;CPU-вариант: onnx/cpu, без ENSEMBLE/IMPROV" style="shape=document;whiteSpace=wrap;html=1;size=0.08;align=left;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c58"><mxGeometry x="1010" y="370" width="260" height="140" as="geometry"/></mxCell><mxCell id="c65" value="&lt;b&gt;Dockerfile&lt;/b&gt; (CPU-вариант, не в compose)&lt;br&gt;onnxruntime, vosk, faster-whisper&lt;br&gt;CMD dispatcher.serve --port 8000" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;dashed=1;align=left;spacingLeft=6;" vertex="1" parent="c58"><mxGeometry x="20" y="230" width="300" height="80" as="geometry"/></mxCell><mxCell id="c66" value="&lt;b&gt;Ассистенты (tools/)&lt;/b&gt;&lt;br&gt;fetch_models.sh · llama_server.sh (Qwen3-1.7B локально)&lt;br&gt;synth_audio.py (espeak/Silero → wav + index.json)&lt;br&gt;train_encoder.py (e5 fine-tune) · export_gigaam.py&lt;br&gt;migrate_scenario.py" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;dashed=1;align=left;spacingLeft=6;" vertex="1" parent="c58"><mxGeometry x="20" y="330" width="300" height="120" as="geometry"/></mxCell><mxCell id="c67" value="&lt;b&gt;Масштабирование (docs/highload.md)&lt;/b&gt;&lt;br&gt;Asterisk ×K → Go ×N (stateless) → Python GPU ×M (stateful, sticky по call_id до BYE)&lt;br&gt;SLO: VAD→аудио p95 &amp;lt; 800 мс; ~50–100 сессий на GPU; дальше Kamailio впереди" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="c58"><mxGeometry x="340" y="230" width="330" height="110" as="geometry"/></mxCell><mxCell id="c68" value="⚠ orchestrator и traineebox оба по умолчанию слушают :8080 — на одном хосте (host network) конфликт портов." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#b85450;" vertex="1" parent="c58"><mxGeometry x="340" y="360" width="330" height="70" as="geometry"/></mxCell><mxCell id="c69" value="Хост (вне compose)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="690" width="900" height="300" as="geometry"/></mxCell><mxCell id="c70" value="&lt;b&gt;traineebox app&lt;/b&gt; (cmd/app)&lt;br&gt;go run / бинарь, Dockerfile нет&lt;br&gt;TRAINEEBOX_HTTP_ADDR=:8080&lt;br&gt;TRAINEEBOX_POSTGRES_DSN (127.0.0.1:5432)&lt;br&gt;TRAINEEBOX_SESSION_SECRET, _SESSION_TTL_HOURS (24)&lt;br&gt;TRAINEEBOX_CATALOG_PATH (автопоиск artifacts/etc/traineebox/catalog)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="c69"><mxGeometry x="20" y="40" width="420" height="140" as="geometry"/></mxCell><mxCell id="c71" value="&lt;b&gt;traineebox initializer&lt;/b&gt; (cmd/initializer)&lt;br&gt;migrate up | down | status (goose, migrations embed.FS)&lt;br&gt;seed-admin --login/--password&lt;br&gt;(TRAINEEBOX_ADMIN_LOGIN=admin, _PASSWORD=adminadmin)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="c69"><mxGeometry x="460" y="40" width="420" height="110" as="geometry"/></mxCell><mxCell id="c72" value="&lt;b&gt;just&lt;/b&gt;: generate · infra · up · up-disp · up-model · down · logs-disp · test (go test ./traineebox) · call [scenario] [to]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=middle;align=left;spacingLeft=6;" vertex="1" parent="c69"><mxGeometry x="20" y="200" width="860" height="50" as="geometry"/></mxCell><mxCell id="c73" value="&lt;b&gt;Софтфон оператора&lt;/b&gt;&lt;br&gt;регистрируется на Asterisk&lt;br&gt;op_test / test1234" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="900" width="240" height="80" as="geometry"/></mxCell><mxCell id="c74" value="&lt;b&gt;GPU хоста&lt;/b&gt; (NVIDIA Container Toolkit)&lt;br&gt;используют: python, llama" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1240" y="900" width="280" height="60" as="geometry"/></mxCell><mxCell id="c75" value="Легенда" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1560" y="900" width="230" height="200" as="geometry"/></mxCell><mxCell id="c76" value="traineebox (Go)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c75"><mxGeometry x="10" y="28" width="210" height="20" as="geometry"/></mxCell><mxCell id="c77" value="ticketgen (Python)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c75"><mxGeometry x="10" y="52" width="210" height="20" as="geometry"/></mxCell><mxCell id="c78" value="dispatcher (Python/Go/Asterisk)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c75"><mxGeometry x="10" y="76" width="210" height="20" as="geometry"/></mxCell><mxCell id="c79" value="инфраструктура" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c75"><mxGeometry x="10" y="100" width="210" height="20" as="geometry"/></mxCell><mxCell id="c80" value="LLM / ML-модели" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c75"><mxGeometry x="10" y="124" width="210" height="20" as="geometry"/></mxCell><mxCell id="c81" value="файлы / данные" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c75"><mxGeometry x="10" y="148" width="210" height="20" as="geometry"/></mxCell><mxCell id="c82" value="люди / внешнее" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c75"><mxGeometry x="10" y="172" width="210" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p843" name="3. БД PostgreSQL (ER)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c83" value="&lt;b style='font-size:22px'&gt;Схема БД emergency (после миграций 00001–00007, goose)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;Справочники (типы/теги/службы) в БД удалены в 00005 и живут в YAML-каталоге: ответы хранят коды (TEXT) без FK. 🔑 — PK, ↗ — FK. Все id — UUID gen_random_uuid() (pgcrypto).&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="60" as="geometry"/></mxCell><mxCell id="c84" value="&lt;b&gt;users&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="300" height="146" as="geometry"/></mxCell><mxCell id="c85" value="🔑 id UUID" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;" vertex="1" parent="c84"><mxGeometry x="0" y="26" width="300" height="20" as="geometry"/></mxCell><mxCell id="c86" value="login TEXT UNIQUE" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;" vertex="1" parent="c84"><mxGeometry x="0" y="46" width="300" height="20"