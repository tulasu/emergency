ddle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;" vertex="1" parent="c689"><mxGeometry x="0" y="166" width="320" height="20" as="geometry"/></mxCell><mxCell id="c698" value="generated BOOL (improv)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;" vertex="1" parent="c689"><mxGeometry x="0" y="186" width="320" height="20" as="geometry"/></mxCell><mxCell id="c699" value="latency_ms INT · votes JSONB" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;" vertex="1" parent="c689"><mxGeometry x="0" y="206" width="320" height="20" as="geometry"/></mxCell><mxCell id="c700" value="wav_path TEXT" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;" vertex="1" parent="c689"><mxGeometry x="0" y="226" width="320" height="20" as="geometry"/></mxCell><mxCell id="c701" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;rounded=0;" edge="1" parent="1" source="c622" target="c612"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c702" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;rounded=0;" edge="1" parent="1" source="c623" target="c612"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c703" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;rounded=0;" edge="1" parent="1" source="c627" target="c612"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c704" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;rounded=0;" edge="1" parent="1" source="c631" target="c612"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c705" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;" edge="1" parent="1" source="c653" target="c646"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c706" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERzeroToOne;endFill=0;startFill=0;rounded=0;" edge="1" parent="1" source="c669" target="c666"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c707" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;rounded=0;" edge="1" parent="1" source="c680" target="c675"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c708" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=10;html=1;endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;rounded=0;" edge="1" parent="1" source="c690" target="c679"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c709" value="facts[].slot → id (логическая)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="c652" target="c611"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="330"/><mxPoint x="900" y="140"/></Array></mxGeometry></mxCell><mxCell id="c710" value="&lt;b&gt;scenario JSONB&lt;/b&gt; — ровно формат data/scenarios/*.json без questions:&lt;br&gt;{ persona: {profile, opening}, meta: {situation}, critical: [..],&lt;br&gt;&amp;nbsp;facts: [{id, slot, answers:{plain, short?, confirm?, correct?}, numbers?, disclosure?, requires?}] }&lt;br&gt;id сценария для dispatcher = ticket_id:version" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="560" height="110" as="geometry"/></mxCell><mxCell id="c711" value="&lt;b&gt;Почему questions не в сценарии&lt;/b&gt;: они принадлежат слоту. Предложенные LLM/преподавателем при генерации билета пишутся в slot_questions (source=ticket, source_ref=ticket_id, status=pending) → после модерации попадают в общий банк. source_ref сохраняет возможность --fresh / bench.loo." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="560" height="110" as="geometry"/></mxCell><mxCell id="c712" value="&lt;b&gt;Правила целостности&lt;/b&gt;&lt;br&gt;• удалять слот нельзя — только archived_at (на него ссылаются сценарии и call_turns)&lt;br&gt;• переименование id слота = миграция данных (JSONB-сценарии, turns)&lt;br&gt;• bank_versions — чтобы dispatcher знал, актуален ли его банк/эмбеддинги, и чтобы в attempt_calls можно было сохранить версию банка для разборов" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="640" y="700" width="640" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p854" name="14. Флоу A: генерация билета со сценарием"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c713" value="&lt;b style='font-size:22px'&gt;ПРОЕКТ · Флоу A — генерация билета: карточка + сценарий заявителя из одного описания&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;ПДн генерируются ОДИН раз и попадают и в эталонную карточку, и в факты сценария — иначе обучающийся услышит одно, а эталон ждёт другое.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="60" as="geometry"/></mxCell><mxCell id="c714" value="Преподаватель" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="200" height="1290" as="geometry"/></mxCell><mxCell id="c715" value="traineebox API" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="200" height="1290" as="geometry"/></mxCell><mxCell id="c716" value="Postgres" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="550" y="90" width="200" height="1290" as="geometry"/></mxCell><mxCell id="c717" value="ticketgen worker" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="90" width="200" height="1290" as="geometry"/></mxCell><mxCell id="c718" value="llama-server" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1070" y="90" width="200" height="1290" as="geometry"/></mxCell><mxCell id="c719" value="dispatcher&lt;br&gt;/scenarios/lint" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="90" width="200" height="1290" as="geometry"/></mxCell><mxCell id="c720" value="POST /groups/{g}/generation-jobs {prompt, mode: voice}" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130.0" y="180" as="sourcePoint"/><mxPoint x="390.0" y="180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c721" value="INSERT job (queued)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390.0" y="226" as="sourcePoint"/><mxPoint x="650.0" y="226" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c722" value="Этапы как сейчас: сценарий-текст → ПДн → тип → теги → службы" style="text;html=1;align=left;spacingLeft=8;fontSize=11;fontStyle=1;fillColor=#eeeeee;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="30" y="258" width="1500" height="26" as="geometry"/></mxCell><mxCell id="c723" value="claim job (SKIP LOCKED, lease)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910.0" y="318" as="sourcePoint"/><mxPoint x="650.0" y="318" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c724" value="generate_scenario → {title, scenario}" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910.0" y="364" as="sourcePoint"/><mxPoint x="1170.0" y="364" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c725" value="fill_pii (Faker): ФИО, caller_number, dictated_number, адрес" style="text;html=1;fontSize=10;align=left;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="918.0" y="394" width="300" height="32" as="geometry"/></mxCell><mxCell id="c726" value="pick_type, теги, службы → draft_reference" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910.0" y="456" as="sourcePoint"/><mxPoint x="1170.0" y="456" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c727" value="НОВОЕ: building_dialog" style="text;html=1;align=left;spacingLeft=8;fontSize=11;fontStyle=1;fillColor=#eeeeee;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="30" y="488" width="1500" height="26" as="geometry"/></mxCell><mxCell id="c728" value="SELECT dialog_slots (+ счётчик approved-формулировок)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910.0" y="548" as="sourcePoint"/><mxPoint x="650.0" y="548" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c729" value="детерминированные факты из ПДн: caller.name, caller.phone, addr.* (без LLM)" style="text;html=1;fontSize=10;align=left;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="918.0" y="578" width="300" height="32" as="geometry"/></mxCell><mxCell id="c730" value="LLM: сценарий + ПДн + список слотов (id, label, kind) → facts[{slot, plain, short, confirm, correct, numbers, disclosure}], opening, critical" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910.0" y="640" as="sourcePoint"/><mxPoint x="1170.0" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c731" value="валидация: slot ∈ онтология, plain не пуст, ≤2 факта на слот, numbers ⊂ числа текста, ПДн совпадают с карточкой, requires ссылаются на факты" style="text;html=1;fontSize=10;align=left;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="918.0" y="670" width="300" height="32" as="geometry"/></mxCell><mxCell id="c732" value="НОВОЕ (опц.): checking_dialog" style="text;html=1;align=left;spacingLeft=8;fontSize=11;fontStyle=1;fillColor=#eeeeee;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="30" y="718" width="1500" height="26" as="geometry"/></mxCell><mxCell id="c733" value="POST /scenarios/lint {scenario} → факты, до которых банк не дотягивается" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910.0" y="778" as="sourcePoint"/><mxPoint x="1430.0" y="778" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c734" value="[{fact, slot, reachable: false, best_slot}]" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;endArrow=open;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1430.0" y="824" as="sourcePoint"/><mxPoint x="910.0" y="824" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c735" value="для недостижимых: LLM → 5–10 формулировок вопроса оператора" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910.0" y="870" as="sourcePoint"/><mxPoint x="1170.0" y="870" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c736" value="INSERT slot_questions (status=pending, source=ticket) · CAS job → ready {draft_reference, draft_scenario, dialog_report}" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910.0" y="916" as="sourcePoint"/><mxPoint x="650.0" y="916" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c737" value="Правка и публикация" style="text;html=1;align=left;spacingLeft=8;fontSize=11;fontStyle=1;fillColor=#eeeeee;strokeColor=#bbbbbb;" vertex="1" parent="1"><mxGeometry x="30" y="948" width="1500" height="26" as="geometry"/></mxCell><mxCell id="c738" value="GET job → карточка + сценарий + отчёт lint" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130.0" y="1008" as="sourcePoint"/><mxPoint x="390.0" y="1008" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c739" value="PATCH job {draft_title, briefing, draft_reference, draft_scenario}" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130.0" y="1054" as="sourcePoint"/><mxPoint x="390.0" y="1054" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c740" value="валидация сценария (Go): слоты, стили, requires, ПДн ≡ карточка" style="text;html=1;fontSize=10;align=left;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="398.0" y="1084" width="300" height="32" as="geometry"/></mxCell><mxCell id="c741" value="POST /generation-jobs/{id}/approve" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130.0" y="1146" as="sourcePoint"/><mxPoint x="390.0" y="1146" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c742" value="ОДНА транзакция: INSERT tickets + reference + ticket_scenarios(v1) + UPDATE job published (CAS)" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390.0" y="1192" as="sourcePoint"/><mxPoint x="650.0" y="1192" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c743" value="модерация: PATCH /dialog/questions/{id} {status: approved}" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130.0" y="1238" as="sourcePoint"/><mxPoint x="390.0" y="1238" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c744" value="UPDATE slot_questions → триггер bank_versions+1 → NOTIFY bank_changed" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390.0" y="1284" as="sourcePoint"/><mxPoint x="650.0" y="1284" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c745" value="&lt;b&gt;Промпт building_dialog&lt;/b&gt; — те же приёмы, что в пайплайне: JSON-ответ, t=0.2, коды только из списка. Список слотов сужается по типу происшествия (маппинг incident_type → семейства слотов, напр. 101 → addr, caller, fire, victim, access, building) — 91 слот целиком маленькой модели много." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1600" y="150" width="560" height="150" as="geometry"/></mxCell><mxCell id="c746" value="&lt;b&gt;Ручной путь&lt;/b&gt;: PUT /tickets/{id}/scenario — тот же валидатор. Для легаси: initializer import-scenarios превращает 97 json в билеты с ticket_scenarios; карточку к ним можно дозаполнить ticketgen-этапами «тип→теги→службы» по meta.situation." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1600" y="320" width="560" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p855" name="15. Флоу B: голосовая попытка (звонок)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c747" value="&lt;b style='font-size:22px'&gt;ПРОЕКТ · Флоу B — старт билета → звонок пользователю → карточка → оценка&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;call_id = UUID, он же id в attempt_calls, session_id в dispatcher и UUID в AudioSocket — одна сквозная метка.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="60" as="geometry"/></mxCell><mxCell id="c748" value="Обучающийся&lt;br&gt;(браузер)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="210" height="1474" as="geometry"/></mxCell><mxCell id="c749" value="traineebox API" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="210" height="1474" as="geometry"/></mxCell><mxCell id="c750" value="Postgres" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="90" width="210" height="1474" as="geometry"/></mxCell><mxCell id="c751" value="orchestrator" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="90" width="210" height="1474" as="geometry"/></mxCell><mxCell id="c752" value="Asterisk" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="90" width="210" height="1474" as="geometry"/></mxCell><mxCell id="c753" value="Софтфон&lt;br&gt;обучающегося" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1380" y="90" width="210" height="1474" as="geometry"/></mxCell><mxCell id="c754" value="dispatcher python" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=56;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1650" y="90" width="210" height="1474" as="geometry"/></mxCell><mxCell id="c755" value="POST /tickets/{t}/attempts {mode: voice}" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="180" as="sourcePoint"/><mxPoint x="405.0" y="180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c756" value="проверки как сейчас + есть ticket_scenarios + у user есть user_sip_endpoints" style="html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405.0" y="226" as="sourcePoint"/><mxPoint x="675.0" y="226" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c757" value="INSERT a