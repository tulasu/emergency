="20" as="geometry"/></mxCell><mxCell id="c606" value="LLM / ML-модели" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c601"><mxGeometry x="10" y="124" width="210" height="20" as="geometry"/></mxCell><mxCell id="c607" value="файлы / данные" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c601"><mxGeometry x="10" y="148" width="210" height="20" as="geometry"/></mxCell><mxCell id="c608" value="люди / внешнее" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="c601"><mxGeometry x="10" y="172" width="210" height="20" as="geometry"/></mxCell><mxCell id="c609" value="&lt;b&gt;Ключевые решения&lt;/b&gt;&lt;br&gt;1. Один владелец схемы — traineebox (goose-миграции). ticketgen и dispatcher — клиенты БД с узкими правами (dispatcher: только чтение банка).&lt;br&gt;2. Сценарий хранится JSONB-снимком в каноническом формате dispatcher → dispatcher переиспользует load_scenario(dict), никакого нового формата.&lt;br&gt;3. В звонок сценарий уходит снимком (версия фиксируется в attempt_calls) — правка билета не ломает идущий звонок.&lt;br&gt;4. Формулировки — общие для слотов, не для билета; сгенерированные LLM попадают в банк только после модерации.&lt;br&gt;5. Итог звонка пишет в БД только traineebox (через orchestrator), как единая точка записи." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1700" y="500" width="560" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p853" name="13. Интеграция: новые таблицы БД"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c610" value="&lt;b style='font-size:22px'&gt;ПРОЕКТ · Новые таблицы (зелёные — новые, синие — существующие)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#555'&gt;Миграции 00008+ в traineebox/migrations. Имена предварительные.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="60" as="geometry"/></mxCell><mxCell id="c611" value="&lt;b&gt;dialog_slots&lt;/b&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="320" height="206" as="geometry"/></mxCell><mxCell id="c612" value="🔑 id TEXT (fire.floor)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;" vertex="1" parent="c611"><mxGeometry x="0" y="26" width="320" height="20" as="geometry"/></mxCell><mxCell id="c613" value="label TEXT" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;" vertex="1" parent="c611"><mxGeometry x="0" y="46" width="320" height="20" as="geometry"/></mxCell><mxCell id="c614" value="kind ∈ {value, yesno, description}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;" vertex="1" parent="c611"><mxGeome